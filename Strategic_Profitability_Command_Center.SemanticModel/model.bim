            "formatString": "#,0",
            "lineageTag": "197e284a-1aa5-439a-ae4d-581f7f889165"
          },
          {
            "name": "Revenue YoY %",
            "description": [
              "Business Definition: [Please provide business logic for Revenue YoY %]",
              "",
              "DAX Formula:",
              "",
              "VAR _Current = [Total Revenue]",
              "VAR _PreviousYear = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Date'[Date]))",
              "RETURN",
              "DIVIDE(_Current - _PreviousYear, _PreviousYear, 0)"
            ],
            "expression": [
              "",
              "VAR _Current = [Total Revenue]",
              "VAR _PreviousYear = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Date'[Date]))",
              "RETURN",
              "DIVIDE(_Current - _PreviousYear, _PreviousYear, 0)"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "lineageTag": "2c5e0f90-26f3-4b9c-bf98-b8b3e01b777b"
          },
          {
