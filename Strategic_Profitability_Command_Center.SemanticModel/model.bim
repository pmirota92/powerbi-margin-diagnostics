            "formatString": "#,0",
            "lineageTag": "a4c214bf-2088-4ffc-8fe6-4cc062d55839"
          },
          {
            "name": "Revenue Bar KPI Card",
            "annotations": [
              {
                "name": "BestPracticeAnalyzer_IgnoreRules",
                "value": "{\"RuleIDs\":[\"DAX_COLUMNS_FULLY_QUALIFIED\"]}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Revenue Bar KPI Card]",
              "",
              "DAX Formula:",
              "",
              "/* =========",
              "   1. Kontekst dat i miary",
              "   ========= */",
              "VAR _LastDate = MAX('Date'[Date])",
              "",
              "-- Uniwersalne szukanie ostatniej daty z danymi (działa z każdą tabelą faktów)",
              "VAR _MaxDateWithData = CALCULATE(MAX('Date'[Date]), FILTER(ALL('Date'), NOT ISBLANK([Total Revenue])))",
              "",
              "-- Kotwica dla osi X (zapewnia, że słupki stoją w miejscu, nawet gdy wybierzesz miesiąc w slicerze)",
              "VAR _StaticReferenceDate = IF(ISBLANK(_MaxDateWithData), MAX('Date'[Date]), _MaxDateWithData)",
              "",
              "-- Data do podświetlenia wybranego miesiąca",
              "VAR _ReferenceDate = IF(ISBLANK(_LastDate), _StaticReferenceDate, _LastDate)",
              "",
              "VAR CurrentVal = [Total Revenue]",
              "VAR PreviousVal = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Date'[Date]))",
              "VAR ChangeVal = DIVIDE(CurrentVal - PreviousVal, PreviousVal)",
              "",
              "/* =========",
              "   2. Budowa tabeli trendu (BEZ STARTOFMONTH!)",
              "   ========= */",
              "VAR _MonthOffsets = SELECTCOLUMNS(GENERATESERIES(0, 11, 1), \"@Offset\", [Value])",
              "",
              "VAR _TrendTable = ",
              "    ADDCOLUMNS(",
              "        _MonthOffsets,",
              "        -- Obliczamy pierwszy dzień miesiąca używając matematyki EOMONTH",
              "        \"@MonthStart\", EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1,",
              "        \"@V\", ",
              "            VAR _TargetStart = EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1",
              "            VAR _TargetEnd = EOMONTH(_StaticReferenceDate, -[@Offset])",
              "            RETURN ",
              "            CALCULATE(",
              "                [Total Revenue], ",
              "                REMOVEFILTERS('Date'),",
              "                'Date'[Date] >= _TargetStart && 'Date'[Date] <= _TargetEnd",
              "            ) + 0",
              "    )",
              "",
              "VAR _FinalTable = ",
              "    ADDCOLUMNS(",
              "        _TrendTable,",
              "        \"Idx\", 12 - [@Offset], ",
              "        -- Podświetlenie wybranego miesiąca",
              "        \"IsMain\", IF(FORMAT([@MonthStart], \"YYYY-MM\") = FORMAT(_ReferenceDate, \"YYYY-MM\"), 1, 0),",
              "        -- Ręczne przypisanie polskich liter miesięcy",
              "        \"PolLabel\", ",
              "            VAR _m = MONTH([@MonthStart])",
              "            RETURN SWITCH(_m, ",
              "                1,\"S\", 2,\"L\", 3,\"M\", 4,\"K\", 5,\"M\", 6,\"C\", ",
              "                7,\"L\", 8,\"S\", 9,\"W\", 10,\"P\", 11,\"L\", 12,\"G\"",
              "            )",
              "    )",
              "",
              "/* =========",
              "   3. Skalowanie i Layout",
              "   ========= */",
              "VAR _ActualMax = MAXX(_FinalTable, [@V])",
              "VAR MaxVal   = IF(_ActualMax = 0, 1, _ActualMax * 1.2)",
              "",
              "VAR SvgWidth     = 260",
              "VAR SvgHeight    = 200",
              "VAR ChartTop     = 95",
              "VAR ChartBottom  = 165",
              "VAR ChartHeight  = ChartBottom - ChartTop",
              "VAR AxisX        = 42",
              "VAR ChartLeft    = 52",
              "VAR ChartRight   = SvgWidth - 20",
              "VAR Step         = DIVIDE ( ChartRight - ChartLeft, 11 )",
              "VAR YScale       = DIVIDE ( ChartHeight, MaxVal )",
              "",
              "/* =========",
              "   4. Generowanie SVG (Z nowymi trendy kolorami)",
              "   ========= */",
              "VAR BarsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        VAR _YTop = INT ( ChartBottom - ([@V] * YScale) )",
              "        VAR _BarHeight = ChartBottom - _YTop",
              "        ",
              "        -- Definiowanie identyfikatorów gradientów pór roku (niewybrane)",
              "        VAR _monthNum = MONTH([@MonthStart])",
              "        VAR _baseFillId = ",
              "            SWITCH(_monthNum,",
              "                12, \"gradZima\", 1, \"gradZima\", 2, \"gradZima\",",
              "                3, \"gradWiosna\", 4, \"gradWiosna\", 5, \"gradWiosna\", ",
              "                6, \"gradLato\", 7, \"gradLato\", 8, \"gradLato\", ",
              "                9, \"gradJesien\", 10, \"gradJesien\", 11, \"gradJesien\" ",
              "            )",
              "",
              "        -- Jeśli słupek jest wybrany, dostaje czerwony \"trendy\" gradient, ",
              "        -- w przeciwnym razie dostaje ładny wielokolorowy pastelowy gradient pory roku.",
              "        VAR _FinalBarFill = IF ( [IsMain] = 1, \"url(#gradTrendyRed)\", \"url(#\" & _baseFillId & \")\" )",
              "        ",
              "        RETURN",
              "            \"<rect x='\" & ( _X - 6 ) & \"' y='\" & _YTop & ",
              "            \"' width='12' height='\" & MAX(_BarHeight, 1) & ",
              "            \"' rx='4' fill='\" & _FinalBarFill & \"' />\",",
              "        \"\"",
              "    )",
              "",
              "VAR XLabelsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        RETURN",
              "        \"<text x='\" & _X & \"' y='\" & ( ChartBottom + 16 ) & ",
              "        \"' text-anchor='middle' font-size='10' font-weight='600' font-family='Segoe UI' fill='#9E9E9E'>\" & [PolLabel] & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "VAR _YSteps = SELECTCOLUMNS(GENERATESERIES(0, 2, 1), \"@Step\", [Value])",
              "VAR YTicks = ",
              "    CONCATENATEX(",
              "        _YSteps,",
              "        VAR _v = [@Step] * 0.5 * MaxVal",
              "        VAR _y = ChartBottom - ([@Step] * 0.5 * ChartHeight)",
              "        VAR _l = IF(_v >= 1000000, FORMAT(_v/1000000, \"#.0\") & \"M\", IF(_v >= 1000, FORMAT(_v/1000, \"#\") & \"K\", FORMAT(_v, \"0\")))",
              "        RETURN",
              "        \"<line x1='\" & (AxisX - 5) & \"' y1='\" & _y & \"' x2='\" & AxisX & \"' y2='\" & _y & \"' stroke='#BDBDBD' stroke-dasharray='2,2'/>\" &",
              "        \"<text x='\" & (AxisX - 8) & \"' y='\" & (_y + 3) & \"' text-anchor='end' font-size='8' fill='#9E9E9E' font-family='Segoe UI'>\" & _l & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "/* =========",
              "   5. Render Finalny z Definicjami Gradientów",
              "   ========= */",
              "VAR SvgBody =",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & SvgWidth & \"' height='\" & SvgHeight & \"' viewBox='0 0 \" & SvgWidth & \" \" & SvgHeight & \"'>\" &",
              "        \"<defs>",
              "            <linearGradient id='gradTrendyRed' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#FF5252' /> <stop offset='100%' stop-color='#B71C1C' /> </linearGradient>",
              "",
              "            <linearGradient id='gradZima' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#BBDEFB' />",
              "                <stop offset='100%' stop-color='#64B5F6' />",
              "            </linearGradient>",
              "            <linearGradient id='gradWiosna' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#C8E6C9' />",
              "                <stop offset='100%' stop-color='#81C784' />",
              "            </linearGradient>",
              "            <linearGradient id='gradLato' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#FFF9C4' />",
              "                <stop offset='100%' stop-color='#FFF176' />",
              "            </linearGradient>",
              "            <linearGradient id='gradJesien' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#FFCCBC' />",
              "                <stop offset='100%' stop-color='#FF8A65' />",
              "            </linearGradient>",
              "        </defs>\" &",
              "        ",
              "        \"<rect x='1' y='1' width='\" & (SvgWidth-2) & \"' height='\" & (SvgHeight-2) & \"' rx='14' fill='white' stroke='#F0F0F0' />\" &",
              "        \"<text x='16' y='30' font-size='12' font-family='Segoe UI' fill='#666666'>Revenue</text>\" &",
              "        \"<text x='16' y='62' font-size='28' font-weight='700' font-family='Segoe UI' fill='#111111'>\" & ",
              "            IF(CurrentVal >= 1000000, FORMAT(CurrentVal, \"$#,,.0M\"), FORMAT(CurrentVal, \"$#,0K\")) & \"</text>\" &",
              "        \"<text x='16' y='82' font-size='11' font-family='Segoe UI' fill='#9E9E9E'>vs Last Year</text>\" &",
              "        \"<text x='180' y='55' font-size='16' font-weight='700' font-family='Segoe UI' fill='\" & IF(ChangeVal>=0,\"#00A651\",\"#E53935\") & \"'>\" & ",
              "            IF(ChangeVal>=0,\"+\",\"\") & FORMAT(ChangeVal,\"0%\") & \"</text>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & ChartTop & \"' x2='\" & AxisX & \"' y2='\" & ChartBottom & \"' stroke='#BDBDBD' />\" &",
              "        YTicks &",
              "        BarsSvg &",
              "        XLabelsSvg &",
              "    \"</svg>\"",
              "",
              "RETURN",
              "    \"data:image/svg+xml;utf8,\" & SvgBody"
            ],
            "expression": [
              "",
              "/* =========",
              "   1. Kontekst dat i miary",
              "   ========= */",
              "VAR _LastDate = MAX('Date'[Date])",
              "",
              "-- Uniwersalne szukanie ostatniej daty z danymi (działa z każdą tabelą faktów)",
              "VAR _MaxDateWithData = CALCULATE(MAX('Date'[Date]), FILTER(ALL('Date'), NOT ISBLANK([Total Revenue])))",
              "",
              "-- Kotwica dla osi X (zapewnia, że słupki stoją w miejscu, nawet gdy wybierzesz miesiąc w slicerze)",
              "VAR _StaticReferenceDate = IF(ISBLANK(_MaxDateWithData), MAX('Date'[Date]), _MaxDateWithData)",
              "",
              "-- Data do podświetlenia wybranego miesiąca",
              "VAR _ReferenceDate = IF(ISBLANK(_LastDate), _StaticReferenceDate, _LastDate)",
              "",
              "VAR CurrentVal = [Total Revenue]",
              "VAR PreviousVal = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Date'[Date]))",
              "VAR ChangeVal = DIVIDE(CurrentVal - PreviousVal, PreviousVal)",
              "",
              "/* =========",
              "   2. Budowa tabeli trendu (BEZ STARTOFMONTH!)",
              "   ========= */",
              "VAR _MonthOffsets = SELECTCOLUMNS(GENERATESERIES(0, 11, 1), \"@Offset\", [Value])",
              "",
              "VAR _TrendTable = ",
              "    ADDCOLUMNS(",
              "        _MonthOffsets,",
              "        -- Obliczamy pierwszy dzień miesiąca używając matematyki EOMONTH",
              "        \"@MonthStart\", EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1,",
              "        \"@V\", ",
              "            VAR _TargetStart = EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1",
              "            VAR _TargetEnd = EOMONTH(_StaticReferenceDate, -[@Offset])",
              "            RETURN ",
              "            CALCULATE(",
              "                [Total Revenue], ",
              "                REMOVEFILTERS('Date'),",
              "                'Date'[Date] >= _TargetStart && 'Date'[Date] <= _TargetEnd",
              "            ) + 0",
              "    )",
              "",
              "VAR _FinalTable = ",
              "    ADDCOLUMNS(",
              "        _TrendTable,",
              "        \"Idx\", 12 - [@Offset], ",
              "        -- Podświetlenie wybranego miesiąca",
              "        \"IsMain\", IF(FORMAT([@MonthStart], \"YYYY-MM\") = FORMAT(_ReferenceDate, \"YYYY-MM\"), 1, 0),",
              "        -- Ręczne przypisanie polskich liter miesięcy",
              "        \"PolLabel\", ",
              "            VAR _m = MONTH([@MonthStart])",
              "            RETURN SWITCH(_m, ",
              "                1,\"S\", 2,\"L\", 3,\"M\", 4,\"K\", 5,\"M\", 6,\"C\", ",
              "                7,\"L\", 8,\"S\", 9,\"W\", 10,\"P\", 11,\"L\", 12,\"G\"",
              "            )",
              "    )",
              "",
              "/* =========",
              "   3. Skalowanie i Layout",
              "   ========= */",
              "VAR _ActualMax = MAXX(_FinalTable, [@V])",
              "VAR MaxVal   = IF(_ActualMax = 0, 1, _ActualMax * 1.2)",
              "",
              "VAR SvgWidth     = 260",
              "VAR SvgHeight    = 200",
              "VAR ChartTop     = 95",
              "VAR ChartBottom  = 165",
              "VAR ChartHeight  = ChartBottom - ChartTop",
              "VAR AxisX        = 42",
              "VAR ChartLeft    = 52",
              "VAR ChartRight   = SvgWidth - 20",
              "VAR Step         = DIVIDE ( ChartRight - ChartLeft, 11 )",
              "VAR YScale       = DIVIDE ( ChartHeight, MaxVal )",
              "",
              "/* =========",
              "   4. Generowanie SVG (Z nowymi trendy kolorami)",
              "   ========= */",
              "VAR BarsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        VAR _YTop = INT ( ChartBottom - ([@V] * YScale) )",
              "        VAR _BarHeight = ChartBottom - _YTop",
              "        ",
              "        -- Definiowanie identyfikatorów gradientów pór roku (niewybrane)",
              "        VAR _monthNum = MONTH([@MonthStart])",
              "        VAR _baseFillId = ",
              "            SWITCH(_monthNum,",
              "                12, \"gradZima\", 1, \"gradZima\", 2, \"gradZima\",",
              "                3, \"gradWiosna\", 4, \"gradWiosna\", 5, \"gradWiosna\", ",
              "                6, \"gradLato\", 7, \"gradLato\", 8, \"gradLato\", ",
              "                9, \"gradJesien\", 10, \"gradJesien\", 11, \"gradJesien\" ",
              "            )",
              "",
              "        -- Jeśli słupek jest wybrany, dostaje czerwony \"trendy\" gradient, ",
              "        -- w przeciwnym razie dostaje ładny wielokolorowy pastelowy gradient pory roku.",
              "        VAR _FinalBarFill = IF ( [IsMain] = 1, \"url(#gradTrendyRed)\", \"url(#\" & _baseFillId & \")\" )",
              "        ",
              "        RETURN",
              "            \"<rect x='\" & ( _X - 6 ) & \"' y='\" & _YTop & ",
              "            \"' width='12' height='\" & MAX(_BarHeight, 1) & ",
              "            \"' rx='4' fill='\" & _FinalBarFill & \"' />\",",
              "        \"\"",
              "    )",
              "",
              "VAR XLabelsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        RETURN",
              "        \"<text x='\" & _X & \"' y='\" & ( ChartBottom + 16 ) & ",
              "        \"' text-anchor='middle' font-size='10' font-weight='600' font-family='Segoe UI' fill='#9E9E9E'>\" & [PolLabel] & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "VAR _YSteps = SELECTCOLUMNS(GENERATESERIES(0, 2, 1), \"@Step\", [Value])",
              "VAR YTicks = ",
              "    CONCATENATEX(",
              "        _YSteps,",
              "        VAR _v = [@Step] * 0.5 * MaxVal",
              "        VAR _y = ChartBottom - ([@Step] * 0.5 * ChartHeight)",
              "        VAR _l = IF(_v >= 1000000, FORMAT(_v/1000000, \"#.0\") & \"M\", IF(_v >= 1000, FORMAT(_v/1000, \"#\") & \"K\", FORMAT(_v, \"0\")))",
              "        RETURN",
              "        \"<line x1='\" & (AxisX - 5) & \"' y1='\" & _y & \"' x2='\" & AxisX & \"' y2='\" & _y & \"' stroke='#BDBDBD' stroke-dasharray='2,2'/>\" &",
              "        \"<text x='\" & (AxisX - 8) & \"' y='\" & (_y + 3) & \"' text-anchor='end' font-size='8' fill='#9E9E9E' font-family='Segoe UI'>\" & _l & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "/* =========",
              "   5. Render Finalny z Definicjami Gradientów",
              "   ========= */",
              "VAR SvgBody =",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & SvgWidth & \"' height='\" & SvgHeight & \"' viewBox='0 0 \" & SvgWidth & \" \" & SvgHeight & \"'>\" &",
              "        \"<defs>",
              "            <linearGradient id='gradTrendyRed' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#FF5252' /> <stop offset='100%' stop-color='#B71C1C' /> </linearGradient>",
              "",
              "            <linearGradient id='gradZima' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#BBDEFB' />",
              "                <stop offset='100%' stop-color='#64B5F6' />",
              "            </linearGradient>",
              "            <linearGradient id='gradWiosna' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#C8E6C9' />",
              "                <stop offset='100%' stop-color='#81C784' />",
              "            </linearGradient>",
              "            <linearGradient id='gradLato' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#FFF9C4' />",
              "                <stop offset='100%' stop-color='#FFF176' />",
              "            </linearGradient>",
              "            <linearGradient id='gradJesien' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'  stop-color='#FFCCBC' />",
              "                <stop offset='100%' stop-color='#FF8A65' />",
              "            </linearGradient>",
              "        </defs>\" &",
              "        ",
              "        \"<rect x='1' y='1' width='\" & (SvgWidth-2) & \"' height='\" & (SvgHeight-2) & \"' rx='14' fill='white' stroke='#F0F0F0' />\" &",
              "        \"<text x='16' y='30' font-size='12' font-family='Segoe UI' fill='#666666'>Revenue</text>\" &",
              "        \"<text x='16' y='62' font-size='28' font-weight='700' font-family='Segoe UI' fill='#111111'>\" & ",
              "            IF(CurrentVal >= 1000000, FORMAT(CurrentVal, \"$#,,.0M\"), FORMAT(CurrentVal, \"$#,0K\")) & \"</text>\" &",
              "        \"<text x='16' y='82' font-size='11' font-family='Segoe UI' fill='#9E9E9E'>vs Last Year</text>\" &",
              "        \"<text x='180' y='55' font-size='16' font-weight='700' font-family='Segoe UI' fill='\" & IF(ChangeVal>=0,\"#00A651\",\"#E53935\") & \"'>\" & ",
              "            IF(ChangeVal>=0,\"+\",\"\") & FORMAT(ChangeVal,\"0%\") & \"</text>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & ChartTop & \"' x2='\" & AxisX & \"' y2='\" & ChartBottom & \"' stroke='#BDBDBD' />\" &",
              "        YTicks &",
              "        BarsSvg &",
              "        XLabelsSvg &",
              "    \"</svg>\"",
              "",
              "RETURN",
              "    \"data:image/svg+xml;utf8,\" & SvgBody"
            ],
            "formatString": "#,0",
            "lineageTag": "87e3c96f-bc0d-4153-b05a-000bda7961cc"
          },
          {
            "name": "Quantity Bar KPI Card",
            "annotations": [
              {
                "name": "BestPracticeAnalyzer_IgnoreRules",
                "value": "{\"RuleIDs\":[\"DAX_COLUMNS_FULLY_QUALIFIED\"]}"
              }
            ],
            "dataCategory": "ImageUrl",
            "description": [
              "Business Definition: [Please provide business logic for Quantity Bar KPI Card]",
              "",
              "DAX Formula:",
              "",
              "/* =========",
              "   1. Kontekst dat i miary",
              "   ========= */",
              "VAR _LastDate = MAX('Date'[Date])",
              "",
              "-- Uniwersalne szukanie ostatniej daty z danymi",
              "VAR _MaxDateWithData = CALCULATE(MAX('Date'[Date]), FILTER(ALL('Date'), NOT ISBLANK([Total Quantity])))",
              "",
              "-- Kotwica dla osi X (zapewnia stabilność słupków)",
              "VAR _StaticReferenceDate = IF(ISBLANK(_MaxDateWithData), MAX('Date'[Date]), _MaxDateWithData)",
              "",
              "-- Data do podświetlenia wybranego miesiąca",
              "VAR _ReferenceDate = IF(ISBLANK(_LastDate), _StaticReferenceDate, _LastDate)",
              "",
              "VAR CurrentVal = [Total Quantity]",
              "VAR PreviousVal = CALCULATE([Total Quantity], SAMEPERIODLASTYEAR('Date'[Date]))",
              "VAR ChangeVal = DIVIDE(CurrentVal - PreviousVal, PreviousVal)",
              "",
              "/* =========",
              "   2. Budowa tabeli trendu",
              "   ========= */",
              "VAR _MonthOffsets = SELECTCOLUMNS(GENERATESERIES(0, 11, 1), \"@Offset\", [Value])",
              "",
              "VAR _TrendTable = ",
              "    ADDCOLUMNS(",
              "        _MonthOffsets,",
              "        \"@MonthStart\", EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1,",
              "        \"@V\", ",
              "            VAR _TargetStart = EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1",
              "            VAR _TargetEnd = EOMONTH(_StaticReferenceDate, -[@Offset])",
              "            RETURN ",
              "            CALCULATE(",
              "                [Total Quantity], ",
              "                REMOVEFILTERS('Date'),",
              "                'Date'[Date] >= _TargetStart && 'Date'[Date] <= _TargetEnd",
              "            ) + 0",
              "    )",
              "",
              "VAR _FinalTable = ",
              "    ADDCOLUMNS(",
              "        _TrendTable,",
              "        \"Idx\", 12 - [@Offset], ",
              "        -- Czy to jest aktualnie wybrany miesiąc?",
              "        \"IsMain\", IF(FORMAT([@MonthStart], \"YYYY-MM\") = FORMAT(_ReferenceDate, \"YYYY-MM\"), 1, 0),",
              "        -- Polskie litery miesięcy",
              "        \"PolLabel\", ",
              "            VAR _m = MONTH([@MonthStart])",
              "            RETURN SWITCH(_m, ",
              "                1,\"S\", 2,\"L\", 3,\"M\", 4,\"K\", 5,\"M\", 6,\"C\", ",
              "                7,\"L\", 8,\"S\", 9,\"W\", 10,\"P\", 11,\"L\", 12,\"G\"",
              "            )",
              "    )",
              "",
              "/* =========",
              "   3. Skalowanie i Layout",
              "   ========= */",
              "VAR _ActualMax = MAXX(_FinalTable, [@V])",
              "VAR MaxVal   = IF(_ActualMax = 0, 1, _ActualMax * 1.2)",
              "",
              "VAR SvgWidth     = 260",
              "VAR SvgHeight    = 200",
              "VAR ChartTop     = 95",
              "VAR ChartBottom  = 165",
              "VAR ChartHeight  = ChartBottom - ChartTop",
              "VAR AxisX        = 42",
              "VAR ChartLeft    = 52",
              "VAR ChartRight   = SvgWidth - 20",
              "VAR Step         = DIVIDE ( ChartRight - ChartLeft, 11 )",
              "VAR YScale       = DIVIDE ( ChartHeight, MaxVal )",
              "",
              "/* =========",
              "   4. Generowanie SVG (Mieszane Kolory)",
              "   ========= */",
              "VAR BarsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        VAR _YTop = INT ( ChartBottom - ([@V] * YScale) )",
              "        VAR _BarHeight = ChartBottom - _YTop",
              "        ",
              "        -- LOGIKA KOLORÓW: Mieszamy zielony ze stalowym w oparciu o to, czy miesiąc jest parzysty",
              "        VAR _MixPattern = MOD(MONTH([@MonthStart]), 4) ",
              "        ",
              "        VAR _FinalBarFill = ",
              "            IF ( [IsMain] = 1, ",
              "                \"url(#gradTrendyRed)\", -- 1. Wybrany miesiąc (czerwony)",
              "                IF([@V] > 0, ",
              "                    IF(_MixPattern = 0, \"url(#gradSteel)\", \"url(#gradGreenSoft)\"), -- 2. Mieszanka stali i zieleni",
              "                    \"url(#gradGrey)\" -- 3. Puste miesiące (zwykły szary)",
              "                )",
              "            )",
              "        ",
              "        RETURN",
              "            \"<rect x='\" & ( _X - 6 ) & \"' y='\" & _YTop & ",
              "            \"' width='12' height='\" & MAX(_BarHeight, 1) & ",
              "            \"' rx='6' fill='\" & _FinalBarFill & \"' />\",",
              "        \"\"",
              "    )",
              "",
              "VAR XLabelsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        RETURN",
              "        \"<text x='\" & _X & \"' y='\" & ( ChartBottom + 16 ) & ",
              "        \"' text-anchor='middle' font-size='10' font-weight='600' font-family='Segoe UI' fill='#9E9E9E'>\" & [PolLabel] & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "VAR _YSteps = SELECTCOLUMNS(GENERATESERIES(0, 2, 1), \"@Step\", [Value])",
              "VAR YTicks = ",
              "    CONCATENATEX(",
              "        _YSteps,",
              "        VAR _v = [@Step] * 0.5 * MaxVal",
              "        VAR _y = ChartBottom - ([@Step] * 0.5 * ChartHeight)",
              "        VAR _l = IF(_v >= 1000000, FORMAT(_v/1000000, \"#.0\") & \"M\", IF(_v >= 1000, FORMAT(_v/1000, \"#\") & \"K\", FORMAT(_v, \"0\")))",
              "        RETURN",
              "        \"<line x1='\" & (AxisX - 5) & \"' y1='\" & _y & \"' x2='\" & AxisX & \"' y2='\" & _y & \"' stroke='#BDBDBD' stroke-dasharray='2,2'/>\" &",
              "        \"<text x='\" & (AxisX - 8) & \"' y='\" & (_y + 3) & \"' text-anchor='end' font-size='8' fill='#9E9E9E' font-family='Segoe UI'>\" & _l & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "/* =========",
              "   5. Render Finalny z Definicjami Gradientów",
              "   ========= */",
              "VAR SvgBody =",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & SvgWidth & \"' height='\" & SvgHeight & \"' viewBox='0 0 \" & SvgWidth & \" \" & SvgHeight & \"'>\" &",
              "        \"<defs>",
              "            <linearGradient id='gradGreenSoft' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#2BA97F' />",
              "                <stop offset='50%'  stop-color='#40C79A' />",
              "                <stop offset='100%' stop-color='#75DCBA' />",
              "            </linearGradient>",
              "",
              "            <linearGradient id='gradSteel' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#CFD8DC' />",
              "                <stop offset='50%'  stop-color='#90A4AE' />",
              "                <stop offset='100%' stop-color='#607D8B' />",
              "            </linearGradient>",
              "",
              "            <linearGradient id='gradGrey' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#F0F0F0' />",
              "                <stop offset='100%' stop-color='#B0B0B0' />",
              "            </linearGradient>",
              "",
              "            <linearGradient id='gradTrendyRed' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#FB7185' />",
              "                <stop offset='50%'  stop-color='#F43F5E' />",
              "                <stop offset='100%' stop-color='#E11D48' />",
              "            </linearGradient>",
              "        </defs>\" &",
              "        ",
              "        \"<rect x='1' y='1' width='\" & (SvgWidth-2) & \"' height='\" & (SvgHeight-2) & \"' rx='14' fill='white' stroke='#F0F0F0' />\" &",
              "        \"<text x='16' y='30' font-size='12' font-family='Segoe UI' fill='#666666'>Quantity</text>\" &",
              "        \"<text x='16' y='62' font-size='28' font-weight='700' font-family='Segoe UI' fill='#111111'>\" & ",
              "            IF(CurrentVal >= 1000000, FORMAT(CurrentVal, \"$#,,.0M\"), FORMAT(CurrentVal, \"$#,0K\")) & \"</text>\" &",
              "        \"<text x='16' y='82' font-size='11' font-family='Segoe UI' fill='#9E9E9E'>vs Last Year</text>\" &",
              "        \"<text x='180' y='55' font-size='16' font-weight='700' font-family='Segoe UI' fill='\" & IF(ChangeVal>=0,\"#40C79A\",\"#F43F5E\") & \"'>\" & ",
              "            IF(ChangeVal>=0,\"+\",\"\") & FORMAT(ChangeVal,\"0%\") & \"</text>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & ChartTop & \"' x2='\" & AxisX & \"' y2='\" & ChartBottom & \"' stroke='#BDBDBD' />\" &",
              "        YTicks &",
              "        BarsSvg &",
              "        XLabelsSvg &",
              "    \"</svg>\"",
              "",
              "RETURN",
              "    \"data:image/svg+xml;utf8,\" & SvgBody"
            ],
            "expression": [
              "",
              "/* =========",
              "   1. Kontekst dat i miary",
              "   ========= */",
              "VAR _LastDate = MAX('Date'[Date])",
              "",
              "-- Uniwersalne szukanie ostatniej daty z danymi",
              "VAR _MaxDateWithData = CALCULATE(MAX('Date'[Date]), FILTER(ALL('Date'), NOT ISBLANK([Total Quantity])))",
              "",
              "-- Kotwica dla osi X (zapewnia stabilność słupków)",
              "VAR _StaticReferenceDate = IF(ISBLANK(_MaxDateWithData), MAX('Date'[Date]), _MaxDateWithData)",
              "",
              "-- Data do podświetlenia wybranego miesiąca",
              "VAR _ReferenceDate = IF(ISBLANK(_LastDate), _StaticReferenceDate, _LastDate)",
              "",
              "VAR CurrentVal = [Total Quantity]",
              "VAR PreviousVal = CALCULATE([Total Quantity], SAMEPERIODLASTYEAR('Date'[Date]))",
              "VAR ChangeVal = DIVIDE(CurrentVal - PreviousVal, PreviousVal)",
              "",
              "/* =========",
              "   2. Budowa tabeli trendu",
              "   ========= */",
              "VAR _MonthOffsets = SELECTCOLUMNS(GENERATESERIES(0, 11, 1), \"@Offset\", [Value])",
              "",
              "VAR _TrendTable = ",
              "    ADDCOLUMNS(",
              "        _MonthOffsets,",
              "        \"@MonthStart\", EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1,",
              "        \"@V\", ",
              "            VAR _TargetStart = EOMONTH(_StaticReferenceDate, -[@Offset] - 1) + 1",
              "            VAR _TargetEnd = EOMONTH(_StaticReferenceDate, -[@Offset])",
              "            RETURN ",
              "            CALCULATE(",
              "                [Total Quantity], ",
              "                REMOVEFILTERS('Date'),",
              "                'Date'[Date] >= _TargetStart && 'Date'[Date] <= _TargetEnd",
              "            ) + 0",
              "    )",
              "",
              "VAR _FinalTable = ",
              "    ADDCOLUMNS(",
              "        _TrendTable,",
              "        \"Idx\", 12 - [@Offset], ",
              "        -- Czy to jest aktualnie wybrany miesiąc?",
              "        \"IsMain\", IF(FORMAT([@MonthStart], \"YYYY-MM\") = FORMAT(_ReferenceDate, \"YYYY-MM\"), 1, 0),",
              "        -- Polskie litery miesięcy",
              "        \"PolLabel\", ",
              "            VAR _m = MONTH([@MonthStart])",
              "            RETURN SWITCH(_m, ",
              "                1,\"S\", 2,\"L\", 3,\"M\", 4,\"K\", 5,\"M\", 6,\"C\", ",
              "                7,\"L\", 8,\"S\", 9,\"W\", 10,\"P\", 11,\"L\", 12,\"G\"",
              "            )",
              "    )",
              "",
              "/* =========",
              "   3. Skalowanie i Layout",
              "   ========= */",
              "VAR _ActualMax = MAXX(_FinalTable, [@V])",
              "VAR MaxVal   = IF(_ActualMax = 0, 1, _ActualMax * 1.2)",
              "",
              "VAR SvgWidth     = 260",
              "VAR SvgHeight    = 200",
              "VAR ChartTop     = 95",
              "VAR ChartBottom  = 165",
              "VAR ChartHeight  = ChartBottom - ChartTop",
              "VAR AxisX        = 42",
              "VAR ChartLeft    = 52",
              "VAR ChartRight   = SvgWidth - 20",
              "VAR Step         = DIVIDE ( ChartRight - ChartLeft, 11 )",
              "VAR YScale       = DIVIDE ( ChartHeight, MaxVal )",
              "",
              "/* =========",
              "   4. Generowanie SVG (Mieszane Kolory)",
              "   ========= */",
              "VAR BarsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        VAR _YTop = INT ( ChartBottom - ([@V] * YScale) )",
              "        VAR _BarHeight = ChartBottom - _YTop",
              "        ",
              "        -- LOGIKA KOLORÓW: Mieszamy zielony ze stalowym w oparciu o to, czy miesiąc jest parzysty",
              "        VAR _MixPattern = MOD(MONTH([@MonthStart]), 4) ",
              "        ",
              "        VAR _FinalBarFill = ",
              "            IF ( [IsMain] = 1, ",
              "                \"url(#gradTrendyRed)\", -- 1. Wybrany miesiąc (czerwony)",
              "                IF([@V] > 0, ",
              "                    IF(_MixPattern = 0, \"url(#gradSteel)\", \"url(#gradGreenSoft)\"), -- 2. Mieszanka stali i zieleni",
              "                    \"url(#gradGrey)\" -- 3. Puste miesiące (zwykły szary)",
              "                )",
              "            )",
              "        ",
              "        RETURN",
              "            \"<rect x='\" & ( _X - 6 ) & \"' y='\" & _YTop & ",
              "            \"' width='12' height='\" & MAX(_BarHeight, 1) & ",
              "            \"' rx='6' fill='\" & _FinalBarFill & \"' />\",",
              "        \"\"",
              "    )",
              "",
              "VAR XLabelsSvg =",
              "    CONCATENATEX (",
              "        _FinalTable,",
              "        VAR _X = INT ( ChartLeft + ( [Idx] - 1 ) * Step )",
              "        RETURN",
              "        \"<text x='\" & _X & \"' y='\" & ( ChartBottom + 16 ) & ",
              "        \"' text-anchor='middle' font-size='10' font-weight='600' font-family='Segoe UI' fill='#9E9E9E'>\" & [PolLabel] & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "VAR _YSteps = SELECTCOLUMNS(GENERATESERIES(0, 2, 1), \"@Step\", [Value])",
              "VAR YTicks = ",
              "    CONCATENATEX(",
              "        _YSteps,",
              "        VAR _v = [@Step] * 0.5 * MaxVal",
              "        VAR _y = ChartBottom - ([@Step] * 0.5 * ChartHeight)",
              "        VAR _l = IF(_v >= 1000000, FORMAT(_v/1000000, \"#.0\") & \"M\", IF(_v >= 1000, FORMAT(_v/1000, \"#\") & \"K\", FORMAT(_v, \"0\")))",
              "        RETURN",
              "        \"<line x1='\" & (AxisX - 5) & \"' y1='\" & _y & \"' x2='\" & AxisX & \"' y2='\" & _y & \"' stroke='#BDBDBD' stroke-dasharray='2,2'/>\" &",
              "        \"<text x='\" & (AxisX - 8) & \"' y='\" & (_y + 3) & \"' text-anchor='end' font-size='8' fill='#9E9E9E' font-family='Segoe UI'>\" & _l & \"</text>\",",
              "        \"\"",
              "    )",
              "",
              "/* =========",
              "   5. Render Finalny z Definicjami Gradientów",
              "   ========= */",
              "VAR SvgBody =",
              "    \"<svg xmlns='http://www.w3.org/2000/svg' width='\" & SvgWidth & \"' height='\" & SvgHeight & \"' viewBox='0 0 \" & SvgWidth & \" \" & SvgHeight & \"'>\" &",
              "        \"<defs>",
              "            <linearGradient id='gradGreenSoft' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#2BA97F' />",
              "                <stop offset='50%'  stop-color='#40C79A' />",
              "                <stop offset='100%' stop-color='#75DCBA' />",
              "            </linearGradient>",
              "",
              "            <linearGradient id='gradSteel' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#CFD8DC' />",
              "                <stop offset='50%'  stop-color='#90A4AE' />",
              "                <stop offset='100%' stop-color='#607D8B' />",
              "            </linearGradient>",
              "",
              "            <linearGradient id='gradGrey' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#F0F0F0' />",
              "                <stop offset='100%' stop-color='#B0B0B0' />",
              "            </linearGradient>",
              "",
              "            <linearGradient id='gradTrendyRed' x1='0' y1='0' x2='0' y2='1'>",
              "                <stop offset='0%'   stop-color='#FB7185' />",
              "                <stop offset='50%'  stop-color='#F43F5E' />",
              "                <stop offset='100%' stop-color='#E11D48' />",
              "            </linearGradient>",
              "        </defs>\" &",
              "        ",
              "        \"<rect x='1' y='1' width='\" & (SvgWidth-2) & \"' height='\" & (SvgHeight-2) & \"' rx='14' fill='white' stroke='#F0F0F0' />\" &",
              "        \"<text x='16' y='30' font-size='12' font-family='Segoe UI' fill='#666666'>Quantity</text>\" &",
              "        \"<text x='16' y='62' font-size='28' font-weight='700' font-family='Segoe UI' fill='#111111'>\" & ",
              "            IF(CurrentVal >= 1000000, FORMAT(CurrentVal, \"$#,,.0M\"), FORMAT(CurrentVal, \"$#,0K\")) & \"</text>\" &",
              "        \"<text x='16' y='82' font-size='11' font-family='Segoe UI' fill='#9E9E9E'>vs Last Year</text>\" &",
              "        \"<text x='180' y='55' font-size='16' font-weight='700' font-family='Segoe UI' fill='\" & IF(ChangeVal>=0,\"#40C79A\",\"#F43F5E\") & \"'>\" & ",
              "            IF(ChangeVal>=0,\"+\",\"\") & FORMAT(ChangeVal,\"0%\") & \"</text>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & ChartTop & \"' x2='\" & AxisX & \"' y2='\" & ChartBottom & \"' stroke='#BDBDBD' />\" &",
              "        YTicks &",
              "        BarsSvg &",
              "        XLabelsSvg &",
              "    \"</svg>\"",
              "",
              "RETURN",
              "    \"data:image/svg+xml;utf8,\" & SvgBody"
            ],
            "formatString": "#,0",
            "lineageTag": "d3c0f992-1000-4606-a942-c22655cc0178"
          },
          {
            "name": "KPI Card SVG (Sales over Date + Axes) - HOLO2",
            "annotations": [
              {
                "name": "BestPracticeAnalyzer_IgnoreRules",
                "value": "{\"RuleIDs\":[\"DAX_COLUMNS_FULLY_QUALIFIED\"]}"
              }
            ],
            "dataCategory": "ImageUrl",
            "description": [
              "Business Definition: [Please provide business logic for KPI Card SVG (Sales over Date + Axes) - HOLO2]",
              "",
              "DAX Formula:",
              "",
              "VAR Title = \"Sales\"",
              "VAR BigValue = FORMAT ( [Total Revenue], \"$#,0\" )",
              "VAR VsLabel = \"vs PY: \" & Format([Revenue YoY %], \"0.00%\")",
              "VAR Line2 = \"CM June: 35,7777 | PM May: 35,000\"",
              "",
              "-- =========================",
              "-- LAYOUT",
              "-- =========================",
              "VAR AxisX = 130",
              "VAR X0    = AxisX + 25",
              "VAR X1    = 735",
              "",
              "-- Dzwoneczek zagnieżdżony w odpowiednim miejscu (Zmieniony kolor na #F43F5E)",
              "VAR _shape = ",
              "    \"<svg x='528' y='46' width='40' height='40' fill='#F43F5E' viewBox='0 0 24 24'>\" &",
              "    \"<path d='M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z'/>\" &",
              "    \"<text x='12' y='18' font-size='16' font-family='Segoe UI' font-weight='bold' fill='white' text-anchor='middle'>!</text>\" &",
              "    \"</svg>\"",
              "",
              "VAR YTop  = 230",
              "VAR YBot  = 340",
              "VAR AxisY = 360",
              "",
              "-- Daty w kontekście",
              "VAR DatesInScope =",
              "    CALCULATETABLE (",
              "        VALUES ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date'[Date] )",
              "    )",
              "",
              "-- Sales per dzień",
              "VAR Series0 =",
              "    ADDCOLUMNS (",
              "        DatesInScope,",
              "        \"__Sales\", CALCULATE ( [Total Revenue] )",
              "    )",
              "",
              "VAR SeriesNB = FILTER ( Series0, NOT ISBLANK ( [__Sales] ) )",
              "VAR N = COUNTROWS ( SeriesNB )",
              "",
              "-- =========================",
              "-- Skala Y: od 0",
              "-- =========================",
              "VAR MaxSales = MAXX ( SeriesNB, [__Sales] )",
              "VAR MinSales = 0",
              "VAR RangeSales = IF ( MaxSales = MinSales, 1, MaxSales - MinSales )",
              "",
              "-- indeks",
              "VAR Series1 =",
              "    ADDCOLUMNS (",
              "        SeriesNB,",
              "        \"__Idx\", RANKX ( SeriesNB, 'Date'[Date], , ASC, Dense )",
              "    )",
              "",
              "-- skalowanie do SVG",
              "VAR Series2 =",
              "    ADDCOLUMNS (",
              "        Series1,",
              "        \"__X\",",
              "            X0 + DIVIDE ( ([__Idx] - 1) * (X1 - X0), MAX ( N - 1, 1 ) ),",
              "        \"__Y\",",
              "            YBot - DIVIDE ( ([__Sales] - MinSales) * (YBot - YTop), RangeSales )",
              "    )",
              "",
              "-- ścieżka wykresu",
              "VAR PathD =",
              "    IF (",
              "        N >= 2,",
              "        \"M \"",
              "            & CONCATENATEX (",
              "                Series2,",
              "                FORMAT ( [__X], \"0\" ) & \" \" & FORMAT ( [__Y], \"0\" ),",
              "                \" L \",",
              "                'Date'[Date],",
              "                ASC",
              "            )",
              "    )",
              "",
              "-- =========================",
              "-- OŚ Y: ticki + etykiety + siatka",
              "-- =========================",
              "VAR YTickCount = 4",
              "VAR YIdx = GENERATESERIES ( 0, YTickCount - 1, 1 )",
              "",
              "VAR YTicks =",
              "    ADDCOLUMNS (",
              "        YIdx,",
              "        \"__y\", YBot - DIVIDE ( [Value], YTickCount - 1 ) * (YBot - YTop),",
              "        \"__label\", FORMAT ( MinSales + DIVIDE ( [Value], YTickCount - 1 ) * RangeSales, \"$#,0\" )",
              "    )",
              "",
              "VAR YAxisSVG =",
              "    CONCATENATEX (",
              "        YTicks,",
              "        \"<line x1='\" & X0 & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & X1 & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#E2E8F0' stroke-width='2' opacity='0.85'/>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & (AxisX-8) & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & (AxisX-12) & \"' y='\" & FORMAT ( [__y] + 6, \"0\" ) & \"' text-anchor='end' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='15' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        1,",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- OŚ X: etykiety dat (start / mid / end)",
              "-- =========================",
              "VAR MidI = INT ( DIVIDE ( N + 1, 2 ) )",
              "",
              "VAR XTickI =",
              "    UNION (",
              "        ROW ( \"i\", 1 ),",
              "        ROW ( \"i\", MidI ),",
              "        ROW ( \"i\", N )",
              "    )",
              "",
              "VAR XTicks =",
              "    ADDCOLUMNS (",
              "        XTickI,",
              "        \"__x\", MAXX ( FILTER ( Series2, [__Idx] = [i] ), [__X] ),",
              "        \"__label\", FORMAT ( MAXX ( FILTER ( Series2, [__Idx] = [i] ), 'Date'[Date] ), \"MMM yy\" )",
              "    )",
              "",
              "VAR XAxisSVG =",
              "    CONCATENATEX (",
              "        XTicks,",
              "        \"<line x1='\" & FORMAT ( [__x], \"0\" ) & \"' y1='\" & AxisY & \"' x2='\" & FORMAT ( [__x], \"0\" ) & \"' y2='\" & (AxisY+6) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & FORMAT ( [__x], \"0\" ) & \"' y='\" & (AxisY+28) & \"' text-anchor='middle' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='15' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        [i],",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- SVG (HOLO DOSTOSOWANE DO TWOICH KOLORÓW)",
              "-- =========================",
              "VAR SVGraw =",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450'>\" &",
              "\"<defs><style>\" &",
              "\".tTitle{font-family:Segoe UI,Arial,sans-serif;font-size:34px;font-weight:700;fill:#334155;opacity:0.90;}\" &",
              "\".tBig{font-family:Segoe UI,Arial,sans-serif;font-size:54px;font-weight:900;fill:#0F172A;}\" &",
              "\".tSub{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:600;fill:#475569;opacity:0.85;}\" &",
              "-- Zmieniony kolor tekstu \"vs PY:\" na #F43F5E",
              "\".pillT{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:800;fill:#F43F5E;}\" &",
              "\"</style>\" &",
              "",
              "-- Tło bazowe",
              "\"<linearGradient id='bgHolo' x1='0' y1='0' x2='1' y2='1'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff'/>\" &",
              "\"<stop offset='40%'  stop-color='#f8fafc'/>\" &",
              "\"<stop offset='100%' stop-color='#f1f5f9'/>\" &",
              "\"</linearGradient>\" &",
              "",
              "-- Glow z lewej",
              "\"<radialGradient id='holoPearl' cx='0.15' cy='0.15' r='0.85'>\" &",
              "\"<stop offset='0%'   stop-color='#10B981' stop-opacity='0.12'/>\" &",
              "\"<stop offset='45%'  stop-color='#10B981' stop-opacity='0.03'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Glow z prawej",
              "\"<radialGradient id='holoNeon' cx='0.90' cy='0.85' r='0.90'>\" &",
              "\"<stop offset='0%'   stop-color='#F43F5E' stop-opacity='0.10'/>\" &",
              "\"<stop offset='50%'  stop-color='#1E293B' stop-opacity='0.05'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "\"<clipPath id='clipCard'><rect x='18' y='18' width='764' height='414' rx='28' ry='28'/></clipPath>\" &",
              "\"<clipPath id='clipChart'><rect x='\" & X0 & \"' y='\" & YTop & \"' width='\" & (X1-X0) & \"' height='\" & (YBot-YTop) & \"'/></clipPath>\" &",
              "\"</defs>\" &",
              "",
              "-- Tło ",
              "\"<g clip-path='url(#clipCard)'>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='url(#bgHolo)'/>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='url(#holoPearl)'/>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='url(#holoNeon)'/>\" &",
              "\"</g>\" &",
              "",
              "-- Subtelna ramka",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='none' stroke='#E2E8F0' stroke-width='2'/>\" &",
              "",
              "\"<text x='400' y='70' text-anchor='middle' class='tTitle'>\" & Title & \"</text>\" &",
              "\"<text x='70' y='150' class='tBig'>\" & BigValue & \"</text>\" &",
              "",
              "-- Ramka w pigułce z dzwoneczkiem (Zmieniony stroke na #F43F5E)",
              "\"<rect x='520' y='40' width='235' height='52' rx='20' ry='20' fill='white' stroke='#F43F5E' stroke-width='3' opacity='0.96'/>\" &",
              "",
              "-- DZWONECZEK",
              "_shape &",
              "",
              "\"<text x='575' y='74' class='pillT'>\" & VsLabel & \"</text>\" &",
              "",
              "\"<text x='70' y='190' class='tSub'>\" & Line2 & \"</text>\" &",
              "",
              "-- OŚ Y",
              "\"<line x1='\" & AxisX & \"' y1='\" & (YTop) & \"' x2='\" & AxisX & \"' y2='\" & (YBot) & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "\"<path d='M \" & AxisX & \" \" & (YTop-10) & \" L \" & (AxisX-8) & \" \" & (YTop+8) & \" L \" & (AxisX+8) & \" \" & (YTop+8) & \" Z' fill='#94A3B8' opacity='0.50'/>\" &",
              "",
              "-- OŚ X",
              "\"<line x1='\" & X0 & \"' y1='\" & AxisY & \"' x2='\" & X1 & \"' y2='\" & AxisY & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "",
              "IF ( N >= 2, YAxisSVG, \"\" ) &",
              "IF ( N >= 2, XAxisSVG, \"\" ) &",
              "",
              "-- Linia trendu (Zmieniony kolor kreski i poświaty na #F43F5E)",
              "IF (",
              "    N >= 2,",
              "    \"<g clip-path='url(#clipChart)'>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='#F43F5E' stroke-width='10' opacity='0.15' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='#F43F5E' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "    \"</g>\",",
              "    \"<text x='70' y='300' font-family='Segoe UI,Arial,sans-serif' font-size='18' fill='#475569' opacity='0.7'>No trend data</text>\"",
              ") &",
              "",
              "\"</svg>\"",
              "",
              "RETURN",
              "\"data:image/svg+xml;utf8,\" & SVGraw"
            ],
            "expression": [
              "",
              "VAR Title = \"Sales\"",
              "VAR BigValue = FORMAT ( [Total Revenue], \"$#,0\" )",
              "VAR VsLabel = \"vs PY: \" & Format([Revenue YoY %], \"0.00%\")",
              "VAR Line2 = \"CM June: 35,7777 | PM May: 35,000\"",
              "",
              "-- =========================",
              "-- LAYOUT",
              "-- =========================",
              "VAR AxisX = 130",
              "VAR X0    = AxisX + 25",
              "VAR X1    = 735",
              "",
              "-- Dzwoneczek zagnieżdżony w odpowiednim miejscu (Zmieniony kolor na #F43F5E)",
              "VAR _shape = ",
              "    \"<svg x='528' y='46' width='40' height='40' fill='#F43F5E' viewBox='0 0 24 24'>\" &",
              "    \"<path d='M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z'/>\" &",
              "    \"<text x='12' y='18' font-size='16' font-family='Segoe UI' font-weight='bold' fill='white' text-anchor='middle'>!</text>\" &",
              "    \"</svg>\"",
              "",
              "VAR YTop  = 230",
              "VAR YBot  = 340",
              "VAR AxisY = 360",
              "",
              "-- Daty w kontekście",
              "VAR DatesInScope =",
              "    CALCULATETABLE (",
              "        VALUES ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date'[Date] )",
              "    )",
              "",
              "-- Sales per dzień",
              "VAR Series0 =",
              "    ADDCOLUMNS (",
              "        DatesInScope,",
              "        \"__Sales\", CALCULATE ( [Total Revenue] )",
              "    )",
              "",
              "VAR SeriesNB = FILTER ( Series0, NOT ISBLANK ( [__Sales] ) )",
              "VAR N = COUNTROWS ( SeriesNB )",
              "",
              "-- =========================",
              "-- Skala Y: od 0",
              "-- =========================",
              "VAR MaxSales = MAXX ( SeriesNB, [__Sales] )",
              "VAR MinSales = 0",
              "VAR RangeSales = IF ( MaxSales = MinSales, 1, MaxSales - MinSales )",
              "",
              "-- indeks",
              "VAR Series1 =",
              "    ADDCOLUMNS (",
              "        SeriesNB,",
              "        \"__Idx\", RANKX ( SeriesNB, 'Date'[Date], , ASC, Dense )",
              "    )",
              "",
              "-- skalowanie do SVG",
              "VAR Series2 =",
              "    ADDCOLUMNS (",
              "        Series1,",
              "        \"__X\",",
              "            X0 + DIVIDE ( ([__Idx] - 1) * (X1 - X0), MAX ( N - 1, 1 ) ),",
              "        \"__Y\",",
              "            YBot - DIVIDE ( ([__Sales] - MinSales) * (YBot - YTop), RangeSales )",
              "    )",
              "",
              "-- ścieżka wykresu",
              "VAR PathD =",
              "    IF (",
              "        N >= 2,",
              "        \"M \"",
              "            & CONCATENATEX (",
              "                Series2,",
              "                FORMAT ( [__X], \"0\" ) & \" \" & FORMAT ( [__Y], \"0\" ),",
              "                \" L \",",
              "                'Date'[Date],",
              "                ASC",
              "            )",
              "    )",
              "",
              "-- =========================",
              "-- OŚ Y: ticki + etykiety + siatka",
              "-- =========================",
              "VAR YTickCount = 4",
              "VAR YIdx = GENERATESERIES ( 0, YTickCount - 1, 1 )",
              "",
              "VAR YTicks =",
              "    ADDCOLUMNS (",
              "        YIdx,",
              "        \"__y\", YBot - DIVIDE ( [Value], YTickCount - 1 ) * (YBot - YTop),",
              "        \"__label\", FORMAT ( MinSales + DIVIDE ( [Value], YTickCount - 1 ) * RangeSales, \"$#,0\" )",
              "    )",
              "",
              "VAR YAxisSVG =",
              "    CONCATENATEX (",
              "        YTicks,",
              "        \"<line x1='\" & X0 & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & X1 & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#E2E8F0' stroke-width='2' opacity='0.85'/>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & (AxisX-8) & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & (AxisX-12) & \"' y='\" & FORMAT ( [__y] + 6, \"0\" ) & \"' text-anchor='end' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='15' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        1,",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- OŚ X: etykiety dat (start / mid / end)",
              "-- =========================",
              "VAR MidI = INT ( DIVIDE ( N + 1, 2 ) )",
              "",
              "VAR XTickI =",
              "    UNION (",
              "        ROW ( \"i\", 1 ),",
              "        ROW ( \"i\", MidI ),",
              "        ROW ( \"i\", N )",
              "    )",
              "",
              "VAR XTicks =",
              "    ADDCOLUMNS (",
              "        XTickI,",
              "        \"__x\", MAXX ( FILTER ( Series2, [__Idx] = [i] ), [__X] ),",
              "        \"__label\", FORMAT ( MAXX ( FILTER ( Series2, [__Idx] = [i] ), 'Date'[Date] ), \"MMM yy\" )",
              "    )",
              "",
              "VAR XAxisSVG =",
              "    CONCATENATEX (",
              "        XTicks,",
              "        \"<line x1='\" & FORMAT ( [__x], \"0\" ) & \"' y1='\" & AxisY & \"' x2='\" & FORMAT ( [__x], \"0\" ) & \"' y2='\" & (AxisY+6) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & FORMAT ( [__x], \"0\" ) & \"' y='\" & (AxisY+28) & \"' text-anchor='middle' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='15' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        [i],",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- SVG (HOLO DOSTOSOWANE DO TWOICH KOLORÓW)",
              "-- =========================",
              "VAR SVGraw =",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450'>\" &",
              "\"<defs><style>\" &",
              "\".tTitle{font-family:Segoe UI,Arial,sans-serif;font-size:34px;font-weight:700;fill:#334155;opacity:0.90;}\" &",
              "\".tBig{font-family:Segoe UI,Arial,sans-serif;font-size:54px;font-weight:900;fill:#0F172A;}\" &",
              "\".tSub{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:600;fill:#475569;opacity:0.85;}\" &",
              "-- Zmieniony kolor tekstu \"vs PY:\" na #F43F5E",
              "\".pillT{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:800;fill:#F43F5E;}\" &",
              "\"</style>\" &",
              "",
              "-- Tło bazowe",
              "\"<linearGradient id='bgHolo' x1='0' y1='0' x2='1' y2='1'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff'/>\" &",
              "\"<stop offset='40%'  stop-color='#f8fafc'/>\" &",
              "\"<stop offset='100%' stop-color='#f1f5f9'/>\" &",
              "\"</linearGradient>\" &",
              "",
              "-- Glow z lewej",
              "\"<radialGradient id='holoPearl' cx='0.15' cy='0.15' r='0.85'>\" &",
              "\"<stop offset='0%'   stop-color='#10B981' stop-opacity='0.12'/>\" &",
              "\"<stop offset='45%'  stop-color='#10B981' stop-opacity='0.03'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Glow z prawej",
              "\"<radialGradient id='holoNeon' cx='0.90' cy='0.85' r='0.90'>\" &",
              "\"<stop offset='0%'   stop-color='#F43F5E' stop-opacity='0.10'/>\" &",
              "\"<stop offset='50%'  stop-color='#1E293B' stop-opacity='0.05'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "\"<clipPath id='clipCard'><rect x='18' y='18' width='764' height='414' rx='28' ry='28'/></clipPath>\" &",
              "\"<clipPath id='clipChart'><rect x='\" & X0 & \"' y='\" & YTop & \"' width='\" & (X1-X0) & \"' height='\" & (YBot-YTop) & \"'/></clipPath>\" &",
              "\"</defs>\" &",
              "",
              "-- Tło ",
              "\"<g clip-path='url(#clipCard)'>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='url(#bgHolo)'/>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='url(#holoPearl)'/>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='url(#holoNeon)'/>\" &",
              "\"</g>\" &",
              "",
              "-- Subtelna ramka",
              "\"<rect x='18' y='18' width='764' height='414' rx='28' ry='28' fill='none' stroke='#E2E8F0' stroke-width='2'/>\" &",
              "",
              "\"<text x='400' y='70' text-anchor='middle' class='tTitle'>\" & Title & \"</text>\" &",
              "\"<text x='70' y='150' class='tBig'>\" & BigValue & \"</text>\" &",
              "",
              "-- Ramka w pigułce z dzwoneczkiem (Zmieniony stroke na #F43F5E)",
              "\"<rect x='520' y='40' width='235' height='52' rx='20' ry='20' fill='white' stroke='#F43F5E' stroke-width='3' opacity='0.96'/>\" &",
              "",
              "-- DZWONECZEK",
              "_shape &",
              "",
              "\"<text x='575' y='74' class='pillT'>\" & VsLabel & \"</text>\" &",
              "",
              "\"<text x='70' y='190' class='tSub'>\" & Line2 & \"</text>\" &",
              "",
              "-- OŚ Y",
              "\"<line x1='\" & AxisX & \"' y1='\" & (YTop) & \"' x2='\" & AxisX & \"' y2='\" & (YBot) & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "\"<path d='M \" & AxisX & \" \" & (YTop-10) & \" L \" & (AxisX-8) & \" \" & (YTop+8) & \" L \" & (AxisX+8) & \" \" & (YTop+8) & \" Z' fill='#94A3B8' opacity='0.50'/>\" &",
              "",
              "-- OŚ X",
              "\"<line x1='\" & X0 & \"' y1='\" & AxisY & \"' x2='\" & X1 & \"' y2='\" & AxisY & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "",
              "IF ( N >= 2, YAxisSVG, \"\" ) &",
              "IF ( N >= 2, XAxisSVG, \"\" ) &",
              "",
              "-- Linia trendu (Zmieniony kolor kreski i poświaty na #F43F5E)",
              "IF (",
              "    N >= 2,",
              "    \"<g clip-path='url(#clipChart)'>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='#F43F5E' stroke-width='10' opacity='0.15' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='#F43F5E' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "    \"</g>\",",
              "    \"<text x='70' y='300' font-family='Segoe UI,Arial,sans-serif' font-size='18' fill='#475569' opacity='0.7'>No trend data</text>\"",
              ") &",
              "",
              "\"</svg>\"",
              "",
              "RETURN",
              "\"data:image/svg+xml;utf8,\" & SVGraw"
            ],
            "formatString": "#,0",
            "lineageTag": "5793543b-ef4c-4890-87fc-ab9ff9663dc3"
          },
          {
            "name": "KPI Card SVG (Sales over Date + Axes) - HOLO3",
            "annotations": [
              {
                "name": "BestPracticeAnalyzer_IgnoreRules",
                "value": "{\"RuleIDs\":[\"DAX_COLUMNS_FULLY_QUALIFIED\"]}"
              }
            ],
            "dataCategory": "ImageUrl",
            "description": [
              "Business Definition: [Please provide business logic for KPI Card SVG (Sales over Date + Axes) - HOLO3]",
              "",
              "DAX Formula:",
              "",
              "-- =========================",
              "-- 1. GŁÓWNE WYMIARY KARTY (Zmieniaj do woli!)",
              "-- =========================",
              "VAR CardW = 700  -- Szerokość całkowita",
              "VAR CardH = 500  -- Wysokość całkowita",
              "",
              "-- Marginesy i zmienne zależne (automatyczne skalowanie)",
              "VAR Pad = 18",
              "VAR RectW = CardW - (Pad * 2)",
              "VAR RectH = CardH - (Pad * 2)",
              "",
              "VAR TitleX = CardW / 2",
              "VAR PillW = 240",
              "VAR PillX = CardW - PillW - 40",
              "VAR ShapeX = PillX + 8",
              "VAR VsTextX = PillX + 55",
              "",
              "-- Pobranie wartości YoY do zmiennej",
              "VAR YoYValue = [Revenue YoY %]",
              "VAR IsPositive = YoYValue >= 0",
              "",
              "-- Dynamiczny główny kolor: Zielony jeśli na plusie, Czerwony jeśli na minusie",
              "VAR MainColor = IF(IsPositive, \"#10B981\", \"#F43F5E\")",
              "",
              "VAR Title = \"Revenue \"",
              "VAR BigValue = FORMAT ( [Total Revenue], \"$#,0\" )",
              "-- Dynamiczne formatowanie (z minusem lub plusem)",
              "VAR VsLabel = \"vs PY: \" & FORMAT(YoYValue, \"+0.00%;-0.00%;0%\")",
              "",
              "/* =========",
              "   Obliczanie MAX Revenue i daty",
              "   ========= */",
              "-- 1. Znajdujemy najwyższy dzienny wynik w wybranym okresie",
              "VAR _MaxDailyRevenue = MAXX(VALUES('Date'[Date]), [Total Revenue])",
              "",
              "-- 2. Szukamy konkretnej daty, w której wystąpił ten maksymalny wynik",
              "-- (Używamy MIN, aby w razie remisu - dwóch dni z tym samym wynikiem - wziąć pierwszą datę)",
              "VAR _MaxDate = ",
              "    CALCULATE(",
              "        MIN('Date'[Date]), ",
              "        FILTER(",
              "            VALUES('Date'[Date]), ",
              "            [Total Revenue] = _MaxDailyRevenue",
              "        )",
              "    )",
              "",
              "-- 3. Formatujemy wartości do wyświetlenia jako tekst",
              "VAR _FormattedMaxRev = FORMAT(_MaxDailyRevenue, \"$#,0\") -- Dodaj np. \"K\" lub \"M\" jeśli chcesz skrócić",
              "VAR _FormattedDate = FORMAT(_MaxDate, \"dd MMM yyyy\") -- Da wynik np. \"15 Jun 2023\"",
              "",
              "-- 4. Sklejamy gotową linijkę tekstu",
              "VAR Line2 = \"MAX: \" & _FormattedMaxRev & \" | \" & _FormattedDate",
              "",
              "-- =========================",
              "-- 2. LAYOUT WYKRESU (zależny od szerokości i wysokości karty)",
              "-- =========================",
              "VAR AxisX = 130",
              "VAR X0    = AxisX + 25",
              "VAR X1    = CardW - 65",
              "",
              "VAR YTop  = CardH - 220",
              "VAR YBot  = CardH - 110",
              "VAR AxisY = CardH - 90",
              "",
              "-- Dynamiczna zmiana ikony",
              "VAR _shape = ",
              "    IF(IsPositive,",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='\" & MainColor & \"'/><path d='M9 12l2 2 4-4' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>\",",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' fill='\" & MainColor & \"' viewBox='0 0 24 24'><path d='M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z'/><text x='12' y='18' font-size='16' font-family='Segoe UI' font-weight='bold' fill='white' text-anchor='middle'>!</text></svg>\"",
              "    )",
              "",
              "-- Daty w kontekście",
              "VAR DatesInScope =",
              "    CALCULATETABLE (",
              "        VALUES ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date'[Date] )",
              "    )",
              "",
              "-- Sales per dzień",
              "VAR Series0 =",
              "    ADDCOLUMNS (",
              "        DatesInScope,",
              "        \"__Sales\", CALCULATE ( [Total Revenue] )",
              "    )",
              "",
              "VAR SeriesNB = FILTER ( Series0, NOT ISBLANK ( [__Sales] ) )",
              "VAR N = COUNTROWS ( SeriesNB )",
              "",
              "-- =========================",
              "-- Skala Y: od 0",
              "-- =========================",
              "VAR MaxSales = MAXX ( SeriesNB, [__Sales] )",
              "VAR MinSales = 0",
              "VAR RangeSales = IF ( MaxSales = MinSales, 1, MaxSales - MinSales )",
              "",
              "-- indeks",
              "VAR Series1 =",
              "    ADDCOLUMNS (",
              "        SeriesNB,",
              "        \"__Idx\", RANKX ( SeriesNB, 'Date'[Date], , ASC, Dense )",
              "    )",
              "",
              "-- skalowanie do SVG",
              "VAR Series2 =",
              "    ADDCOLUMNS (",
              "        Series1,",
              "        \"__X\", X0 + DIVIDE ( ([__Idx] - 1) * (X1 - X0), MAX ( N - 1, 1 ) ),",
              "        \"__Y\", YBot - DIVIDE ( ([__Sales] - MinSales) * (YBot - YTop), RangeSales )",
              "    )",
              "",
              "-- ścieżka wykresu",
              "VAR PathD =",
              "    IF (",
              "        N >= 2,",
              "        \"M \"",
              "            & CONCATENATEX (",
              "                Series2,",
              "                FORMAT ( [__X], \"0\" ) & \" \" & FORMAT ( [__Y], \"0\" ),",
              "                \" L \",",
              "                'Date'[Date],",
              "                ASC",
              "            )",
              "    )",
              "",
              "-- =========================",
              "-- OŚ Y: ticki + etykiety + siatka",
              "-- =========================",
              "VAR YTickCount = 4",
              "VAR YIdx = GENERATESERIES ( 0, YTickCount - 1, 1 )",
              "",
              "VAR YTicks =",
              "    ADDCOLUMNS (",
              "        YIdx,",
              "        \"__y\", YBot - DIVIDE ( [Value], YTickCount - 1 ) * (YBot - YTop),",
              "        \"__label\", FORMAT ( MinSales + DIVIDE ( [Value], YTickCount - 1 ) * RangeSales, \"$#,0\" )",
              "    )",
              "",
              "VAR YAxisSVG =",
              "    CONCATENATEX (",
              "        YTicks,",
              "        \"<line x1='\" & X0 & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & X1 & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#E2E8F0' stroke-width='2' opacity='0.85'/>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & (AxisX-8) & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & (AxisX-14) & \"' y='\" & FORMAT ( [__y] + 8, \"0\" ) & \"' text-anchor='end' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        1,",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- OŚ X: etykiety dat (start / mid / end)",
              "-- =========================",
              "VAR MidI = INT ( DIVIDE ( N + 1, 2 ) )",
              "",
              "VAR XTickI =",
              "    UNION (",
              "        ROW ( \"i\", 1 ),",
              "        ROW ( \"i\", MidI ),",
              "        ROW ( \"i\", N )",
              "    )",
              "",
              "VAR XTicks =",
              "    ADDCOLUMNS (",
              "        XTickI,",
              "        \"__x\", MAXX ( FILTER ( Series2, [__Idx] = [i] ), [__X] ),",
              "        \"__label\", FORMAT ( MAXX ( FILTER ( Series2, [__Idx] = [i] ), 'Date'[Date] ), \"MMM yy\" )",
              "    )",
              "",
              "VAR XAxisSVG =",
              "    CONCATENATEX (",
              "        XTicks,",
              "        \"<line x1='\" & FORMAT ( [__x], \"0\" ) & \"' y1='\" & AxisY & \"' x2='\" & FORMAT ( [__x], \"0\" ) & \"' y2='\" & (AxisY+6) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & FORMAT ( [__x], \"0\" ) & \"' y='\" & (AxisY+32) & \"' text-anchor='middle' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        [i],",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- 3. RENDER SVG",
              "-- =========================",
              "VAR SVGraw =",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 \" & CardW & \" \" & CardH & \"'>\" &",
              "\"<defs><style>\" &",
              "\".tTitle{font-family:Segoe UI,Arial,sans-serif;font-size:34px;font-weight:700;fill:#334155;opacity:0.90;}\" &",
              "\".tBig{font-family:Segoe UI,Arial,sans-serif;font-size:54px;font-weight:900;fill:#0F172A;}\" &",
              "\".tSub{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:600;fill:#475569;opacity:0.85;}\" &",
              "\".pillT{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:800;fill:\" & MainColor & \";}\" &",
              "\"</style>\" &",
              "",
              "-- Tło bazowe",
              "\"<linearGradient id='bgHolo' x1='0' y1='0' x2='1' y2='1'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff'/>\" &",
              "\"<stop offset='40%'  stop-color='#f8fafc'/>\" &",
              "\"<stop offset='100%' stop-color='#f1f5f9'/>\" &",
              "\"</linearGradient>\" &",
              "",
              "-- Glow z lewej",
              "\"<radialGradient id='holoPearl' cx='0.15' cy='0.15' r='0.85'>\" &",
              "\"<stop offset='0%'   stop-color='#10B981' stop-opacity='0.12'/>\" &",
              "\"<stop offset='45%'  stop-color='#10B981' stop-opacity='0.03'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Glow z prawej",
              "\"<radialGradient id='holoNeon' cx='0.90' cy='0.85' r='0.90'>\" &",
              "\"<stop offset='0%'   stop-color='#F43F5E' stop-opacity='0.10'/>\" &",
              "\"<stop offset='50%'  stop-color='#1E293B' stop-opacity='0.05'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Użycie zautomatyzowanych zmiennych Marginesów (RectW, RectH)",
              "\"<clipPath id='clipCard'><rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28'/></clipPath>\" &",
              "\"<clipPath id='clipChart'><rect x='\" & X0 & \"' y='\" & YTop & \"' width='\" & (X1-X0) & \"' height='\" & (YBot-YTop) & \"'/></clipPath>\" &",
              "\"</defs>\" &",
              "",
              "-- Tło ",
              "\"<g clip-path='url(#clipCard)'>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#bgHolo)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoPearl)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoNeon)'/>\" &",
              "\"</g>\" &",
              "",
              "-- Subtelna ramka",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='none' stroke='#E2E8F0' stroke-width='2'/>\" &",
              "",
              "-- TYTUŁ WYRÓWNANY DO LEWEJ (x='70')",
              "\"<text x='70' y='70' class='tTitle'>\" & Title & \"</text>\" &",
              "\"<text x='70' y='150' class='tBig'>\" & BigValue & \"</text>\" &",
              "",
              "-- Ramka w pigułce z dynamicznym stroke i ułożeniem względem prawej",
              "\"<rect x='\" & PillX & \"' y='40' width='\" & PillW & \"' height='52' rx='20' ry='20' fill='white' stroke='\" & MainColor & \"' stroke-width='3' opacity='0.96'/>\" &",
              "",
              "-- DYNAMICZNY KSZTAŁT",
              "_shape &",
              "",
              "\"<text x='\" & VsTextX & \"' y='74' class='pillT'>\" & VsLabel & \"</text>\" &",
              "",
              "\"<text x='70' y='190' class='tSub'>\" & Line2 & \"</text>\" &",
              "",
              "-- OŚ Y",
              "\"<line x1='\" & AxisX & \"' y1='\" & (YTop) & \"' x2='\" & AxisX & \"' y2='\" & (YBot) & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "\"<path d='M \" & AxisX & \" \" & (YTop-10) & \" L \" & (AxisX-8) & \" \" & (YTop+8) & \" L \" & (AxisX+8) & \" \" & (YTop+8) & \" Z' fill='#94A3B8' opacity='0.50'/>\" &",
              "",
              "-- OŚ X",
              "\"<line x1='\" & X0 & \"' y1='\" & AxisY & \"' x2='\" & X1 & \"' y2='\" & AxisY & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "",
              "IF ( N >= 2, YAxisSVG, \"\" ) &",
              "IF ( N >= 2, XAxisSVG, \"\" ) &",
              "",
              "-- Linia trendu podpięta pod MainColor",
              "IF (",
              "    N >= 2,",
              "    \"<g clip-path='url(#clipChart)'>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='10' opacity='0.15' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "    \"</g>\",",
              "    \"<text x='70' y='\" & (YTop + 70) & \"' font-family='Segoe UI,Arial,sans-serif' font-size='18' fill='#475569' opacity='0.7'>No trend data</text>\"",
              ") &",
              "",
              "\"</svg>\"",
              "",
              "RETURN",
              "\"data:image/svg+xml;utf8,\" & SVGraw"
            ],
            "expression": [
              "",
              "-- =========================",
              "-- 1. GŁÓWNE WYMIARY KARTY (Zmieniaj do woli!)",
              "-- =========================",
              "VAR CardW = 700  -- Szerokość całkowita",
              "VAR CardH = 500  -- Wysokość całkowita",
              "",
              "-- Marginesy i zmienne zależne (automatyczne skalowanie)",
              "VAR Pad = 18",
              "VAR RectW = CardW - (Pad * 2)",
              "VAR RectH = CardH - (Pad * 2)",
              "",
              "VAR TitleX = CardW / 2",
              "VAR PillW = 240",
              "VAR PillX = CardW - PillW - 40",
              "VAR ShapeX = PillX + 8",
              "VAR VsTextX = PillX + 55",
              "",
              "-- Pobranie wartości YoY do zmiennej",
              "VAR YoYValue = [Revenue YoY %]",
              "VAR IsPositive = YoYValue >= 0",
              "",
              "-- Dynamiczny główny kolor: Zielony jeśli na plusie, Czerwony jeśli na minusie",
              "VAR MainColor = IF(IsPositive, \"#10B981\", \"#F43F5E\")",
              "",
              "VAR Title = \"Revenue \"",
              "VAR BigValue = FORMAT ( [Total Revenue], \"$#,0\" )",
              "-- Dynamiczne formatowanie (z minusem lub plusem)",
              "VAR VsLabel = \"vs PY: \" & FORMAT(YoYValue, \"+0.00%;-0.00%;0%\")",
              "",
              "/* =========",
              "   Obliczanie MAX Revenue i daty",
              "   ========= */",
              "-- 1. Znajdujemy najwyższy dzienny wynik w wybranym okresie",
              "VAR _MaxDailyRevenue = MAXX(VALUES('Date'[Date]), [Total Revenue])",
              "",
              "-- 2. Szukamy konkretnej daty, w której wystąpił ten maksymalny wynik",
              "-- (Używamy MIN, aby w razie remisu - dwóch dni z tym samym wynikiem - wziąć pierwszą datę)",
              "VAR _MaxDate = ",
              "    CALCULATE(",
              "        MIN('Date'[Date]), ",
              "        FILTER(",
              "            VALUES('Date'[Date]), ",
              "            [Total Revenue] = _MaxDailyRevenue",
              "        )",
              "    )",
              "",
              "-- 3. Formatujemy wartości do wyświetlenia jako tekst",
              "VAR _FormattedMaxRev = FORMAT(_MaxDailyRevenue, \"$#,0\") -- Dodaj np. \"K\" lub \"M\" jeśli chcesz skrócić",
              "VAR _FormattedDate = FORMAT(_MaxDate, \"dd MMM yyyy\") -- Da wynik np. \"15 Jun 2023\"",
              "",
              "-- 4. Sklejamy gotową linijkę tekstu",
              "VAR Line2 = \"MAX: \" & _FormattedMaxRev & \" | \" & _FormattedDate",
              "",
              "-- =========================",
              "-- 2. LAYOUT WYKRESU (zależny od szerokości i wysokości karty)",
              "-- =========================",
              "VAR AxisX = 130",
              "VAR X0    = AxisX + 25",
              "VAR X1    = CardW - 65",
              "",
              "VAR YTop  = CardH - 220",
              "VAR YBot  = CardH - 110",
              "VAR AxisY = CardH - 90",
              "",
              "-- Dynamiczna zmiana ikony",
              "VAR _shape = ",
              "    IF(IsPositive,",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='\" & MainColor & \"'/><path d='M9 12l2 2 4-4' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>\",",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' fill='\" & MainColor & \"' viewBox='0 0 24 24'><path d='M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z'/><text x='12' y='18' font-size='16' font-family='Segoe UI' font-weight='bold' fill='white' text-anchor='middle'>!</text></svg>\"",
              "    )",
              "",
              "-- Daty w kontekście",
              "VAR DatesInScope =",
              "    CALCULATETABLE (",
              "        VALUES ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date'[Date] )",
              "    )",
              "",
              "-- Sales per dzień",
              "VAR Series0 =",
              "    ADDCOLUMNS (",
              "        DatesInScope,",
              "        \"__Sales\", CALCULATE ( [Total Revenue] )",
              "    )",
              "",
              "VAR SeriesNB = FILTER ( Series0, NOT ISBLANK ( [__Sales] ) )",
              "VAR N = COUNTROWS ( SeriesNB )",
              "",
              "-- =========================",
              "-- Skala Y: od 0",
              "-- =========================",
              "VAR MaxSales = MAXX ( SeriesNB, [__Sales] )",
              "VAR MinSales = 0",
              "VAR RangeSales = IF ( MaxSales = MinSales, 1, MaxSales - MinSales )",
              "",
              "-- indeks",
              "VAR Series1 =",
              "    ADDCOLUMNS (",
              "        SeriesNB,",
              "        \"__Idx\", RANKX ( SeriesNB, 'Date'[Date], , ASC, Dense )",
              "    )",
              "",
              "-- skalowanie do SVG",
              "VAR Series2 =",
              "    ADDCOLUMNS (",
              "        Series1,",
              "        \"__X\", X0 + DIVIDE ( ([__Idx] - 1) * (X1 - X0), MAX ( N - 1, 1 ) ),",
              "        \"__Y\", YBot - DIVIDE ( ([__Sales] - MinSales) * (YBot - YTop), RangeSales )",
              "    )",
              "",
              "-- ścieżka wykresu",
              "VAR PathD =",
              "    IF (",
              "        N >= 2,",
              "        \"M \"",
              "            & CONCATENATEX (",
              "                Series2,",
              "                FORMAT ( [__X], \"0\" ) & \" \" & FORMAT ( [__Y], \"0\" ),",
              "                \" L \",",
              "                'Date'[Date],",
              "                ASC",
              "            )",
              "    )",
              "",
              "-- =========================",
              "-- OŚ Y: ticki + etykiety + siatka",
              "-- =========================",
              "VAR YTickCount = 4",
              "VAR YIdx = GENERATESERIES ( 0, YTickCount - 1, 1 )",
              "",
              "VAR YTicks =",
              "    ADDCOLUMNS (",
              "        YIdx,",
              "        \"__y\", YBot - DIVIDE ( [Value], YTickCount - 1 ) * (YBot - YTop),",
              "        \"__label\", FORMAT ( MinSales + DIVIDE ( [Value], YTickCount - 1 ) * RangeSales, \"$#,0\" )",
              "    )",
              "",
              "VAR YAxisSVG =",
              "    CONCATENATEX (",
              "        YTicks,",
              "        \"<line x1='\" & X0 & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & X1 & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#E2E8F0' stroke-width='2' opacity='0.85'/>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & (AxisX-8) & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & (AxisX-14) & \"' y='\" & FORMAT ( [__y] + 8, \"0\" ) & \"' text-anchor='end' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        1,",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- OŚ X: etykiety dat (start / mid / end)",
              "-- =========================",
              "VAR MidI = INT ( DIVIDE ( N + 1, 2 ) )",
              "",
              "VAR XTickI =",
              "    UNION (",
              "        ROW ( \"i\", 1 ),",
              "        ROW ( \"i\", MidI ),",
              "        ROW ( \"i\", N )",
              "    )",
              "",
              "VAR XTicks =",
              "    ADDCOLUMNS (",
              "        XTickI,",
              "        \"__x\", MAXX ( FILTER ( Series2, [__Idx] = [i] ), [__X] ),",
              "        \"__label\", FORMAT ( MAXX ( FILTER ( Series2, [__Idx] = [i] ), 'Date'[Date] ), \"MMM yy\" )",
              "    )",
              "",
              "VAR XAxisSVG =",
              "    CONCATENATEX (",
              "        XTicks,",
              "        \"<line x1='\" & FORMAT ( [__x], \"0\" ) & \"' y1='\" & AxisY & \"' x2='\" & FORMAT ( [__x], \"0\" ) & \"' y2='\" & (AxisY+6) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & FORMAT ( [__x], \"0\" ) & \"' y='\" & (AxisY+32) & \"' text-anchor='middle' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        [i],",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- 3. RENDER SVG",
              "-- =========================",
              "VAR SVGraw =",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 \" & CardW & \" \" & CardH & \"'>\" &",
              "\"<defs><style>\" &",
              "\".tTitle{font-family:Segoe UI,Arial,sans-serif;font-size:34px;font-weight:700;fill:#334155;opacity:0.90;}\" &",
              "\".tBig{font-family:Segoe UI,Arial,sans-serif;font-size:54px;font-weight:900;fill:#0F172A;}\" &",
              "\".tSub{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:600;fill:#475569;opacity:0.85;}\" &",
              "\".pillT{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:800;fill:\" & MainColor & \";}\" &",
              "\"</style>\" &",
              "",
              "-- Tło bazowe",
              "\"<linearGradient id='bgHolo' x1='0' y1='0' x2='1' y2='1'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff'/>\" &",
              "\"<stop offset='40%'  stop-color='#f8fafc'/>\" &",
              "\"<stop offset='100%' stop-color='#f1f5f9'/>\" &",
              "\"</linearGradient>\" &",
              "",
              "-- Glow z lewej",
              "\"<radialGradient id='holoPearl' cx='0.15' cy='0.15' r='0.85'>\" &",
              "\"<stop offset='0%'   stop-color='#10B981' stop-opacity='0.12'/>\" &",
              "\"<stop offset='45%'  stop-color='#10B981' stop-opacity='0.03'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Glow z prawej",
              "\"<radialGradient id='holoNeon' cx='0.90' cy='0.85' r='0.90'>\" &",
              "\"<stop offset='0%'   stop-color='#F43F5E' stop-opacity='0.10'/>\" &",
              "\"<stop offset='50%'  stop-color='#1E293B' stop-opacity='0.05'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Użycie zautomatyzowanych zmiennych Marginesów (RectW, RectH)",
              "\"<clipPath id='clipCard'><rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28'/></clipPath>\" &",
              "\"<clipPath id='clipChart'><rect x='\" & X0 & \"' y='\" & YTop & \"' width='\" & (X1-X0) & \"' height='\" & (YBot-YTop) & \"'/></clipPath>\" &",
              "\"</defs>\" &",
              "",
              "-- Tło ",
              "\"<g clip-path='url(#clipCard)'>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#bgHolo)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoPearl)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoNeon)'/>\" &",
              "\"</g>\" &",
              "",
              "-- Subtelna ramka",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='none' stroke='#E2E8F0' stroke-width='2'/>\" &",
              "",
              "-- TYTUŁ WYRÓWNANY DO LEWEJ (x='70')",
              "\"<text x='70' y='70' class='tTitle'>\" & Title & \"</text>\" &",
              "\"<text x='70' y='150' class='tBig'>\" & BigValue & \"</text>\" &",
              "",
              "-- Ramka w pigułce z dynamicznym stroke i ułożeniem względem prawej",
              "\"<rect x='\" & PillX & \"' y='40' width='\" & PillW & \"' height='52' rx='20' ry='20' fill='white' stroke='\" & MainColor & \"' stroke-width='3' opacity='0.96'/>\" &",
              "",
              "-- DYNAMICZNY KSZTAŁT",
              "_shape &",
              "",
              "\"<text x='\" & VsTextX & \"' y='74' class='pillT'>\" & VsLabel & \"</text>\" &",
              "",
              "\"<text x='70' y='190' class='tSub'>\" & Line2 & \"</text>\" &",
              "",
              "-- OŚ Y",
              "\"<line x1='\" & AxisX & \"' y1='\" & (YTop) & \"' x2='\" & AxisX & \"' y2='\" & (YBot) & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "\"<path d='M \" & AxisX & \" \" & (YTop-10) & \" L \" & (AxisX-8) & \" \" & (YTop+8) & \" L \" & (AxisX+8) & \" \" & (YTop+8) & \" Z' fill='#94A3B8' opacity='0.50'/>\" &",
              "",
              "-- OŚ X",
              "\"<line x1='\" & X0 & \"' y1='\" & AxisY & \"' x2='\" & X1 & \"' y2='\" & AxisY & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "",
              "IF ( N >= 2, YAxisSVG, \"\" ) &",
              "IF ( N >= 2, XAxisSVG, \"\" ) &",
              "",
              "-- Linia trendu podpięta pod MainColor",
              "IF (",
              "    N >= 2,",
              "    \"<g clip-path='url(#clipChart)'>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='10' opacity='0.15' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "    \"</g>\",",
              "    \"<text x='70' y='\" & (YTop + 70) & \"' font-family='Segoe UI,Arial,sans-serif' font-size='18' fill='#475569' opacity='0.7'>No trend data</text>\"",
              ") &",
              "",
              "\"</svg>\"",
              "",
              "RETURN",
              "\"data:image/svg+xml;utf8,\" & SVGraw"
            ],
            "formatString": "#,0",
            "lineageTag": "baf81e43-d9f9-4ff5-99f3-8f2dcab2ffb7"
          },
          {
            "name": "Gross_Margin_YoY",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Gross_Margin_YoY]",
              "",
              "DAX Formula:",
              "",
              "[Gross Margin] - [Gross_Margin_PY]"
            ],
            "expression": [
              "",
              "[Gross Margin] - [Gross_Margin_PY]"
            ],
            "formatString": "#,0",
            "lineageTag": "28f8af2c-f5df-43a8-9161-3e1e6472db8c"
          },
          {
            "name": "Gross_Margin_PY",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Gross_Margin_PY]",
              "",
              "DAX Formula:",
              "",
              "CALCULATE(",
              "    [Gross Margin], ",
              "    SAMEPERIODLASTYEAR('Date'[Date])",
              ")"
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [Gross Margin], ",
              "    SAMEPERIODLASTYEAR('Date'[Date])",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "aef88d53-1196-42bb-81e3-82ab50cbf89e"
          },
          {
            "name": "Waterfall_Value_Native",
            "description": [
              "Business Definition: [Please provide business logic for Waterfall_Value_Native]",
              "",
              "DAX Formula:",
              "",
              "VAR SelPeriod = SELECTEDVALUE('Waterfall_Periods'[Period])",
              "",
              "RETURN",
              "SWITCH(SelPeriod,",
              "    \"1. Margin LY\", [Gross_Margin_PY],",
              "    \"2. Margin CY\", [Gross Margin]",
              ")"
            ],
            "expression": [
              "",
              "VAR SelPeriod = SELECTEDVALUE('Waterfall_Periods'[Period])",
              "",
              "RETURN",
              "SWITCH(SelPeriod,",
              "    \"1. Margin LY\", [Gross_Margin_PY],",
              "    \"2. Margin CY\", [Gross Margin]",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "8ac2fcb6-81be-492b-9f2e-73e2b0a513da"
          },
          {
            "name": "Waterfall_PVM_Value",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Waterfall_PVM_Value]",
              "",
              "DAX Formula:",
              "",
              "VAR selectedCategory = SELECTEDVALUE(Waterfall_Periods[Period])",
              "VAR selectedBreakdown = SELECTEDVALUE('Steps_PVM'[Step])",
              "",
              "RETURN",
              "    SWITCH(selectedCategory,",
              "        \"1. Margin LY\",",
              "            SWITCH(selectedBreakdown,",
              "                \"Volume Impact\", 0,",
              "                \"Price Impact\", 0,",
              "                \"Cost Impact\", 0,",
              "                [Gross_Margin_PY]  ",
              "            ),",
              "        \"2. Margin CY\",",
              "            SWITCH(selectedBreakdown,",
              "                \"Volume Impact\", [Volume Impact2],",
              "                \"Price Impact\", [Price Impact2],",
              "                \"Cost Impact\", [Mix Impact],",
              "                [Gross Margin]     ",
              "            )",
              "    )"
            ],
            "expression": [
              "",
              "VAR selectedCategory = SELECTEDVALUE(Waterfall_Periods[Period])",
              "VAR selectedBreakdown = SELECTEDVALUE('Steps_PVM'[Step])",
              "",
              "RETURN",
              "    SWITCH(selectedCategory,",
              "        \"1. Margin LY\",",
              "            SWITCH(selectedBreakdown,",
              "                \"Volume Impact\", 0,",
              "                \"Price Impact\", 0,",
              "                \"Cost Impact\", 0,",
              "                [Gross_Margin_PY]  ",
              "            ),",
              "        \"2. Margin CY\",",
              "            SWITCH(selectedBreakdown,",
              "                \"Volume Impact\", [Volume Impact2],",
              "                \"Price Impact\", [Price Impact2],",
              "                \"Cost Impact\", [Mix Impact],",
              "                [Gross Margin]     ",
              "            )",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "0d626e9b-e261-4a8c-bd92-d82198c4d8ea"
          },
          {
            "name": "Price Impact2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Price Impact2]",
              "",
              "DAX Formula:",
              "",
              "SUMX(",
              "    'Dim_Product',  // Power BI schodzi do poziomu każdego produktu",
              "    VAR CenaCY = DIVIDE([Total Revenue], [Total Quantity])",
              "    VAR CenaPY = DIVIDE([Revenue PY], [Quantity PY])",
              "    ",
              "    RETURN ",
              "    // Jeśli produkt sprzedawał się w obu latach, licz wpływ ceny",
              "    IF(",
              "        NOT ISBLANK(CenaCY) && NOT ISBLANK(CenaPY),",
              "        (CenaCY - CenaPY) * [Total Quantity],",
              "        BLANK()",
              "    )",
              ")"
            ],
            "expression": [
              "",
              "SUMX(",
              "    'Dim_Product',  // Power BI schodzi do poziomu każdego produktu",
              "    VAR CenaCY = DIVIDE([Total Revenue], [Total Quantity])",
              "    VAR CenaPY = DIVIDE([Revenue PY], [Quantity PY])",
              "    ",
              "    RETURN ",
              "    // Jeśli produkt sprzedawał się w obu latach, licz wpływ ceny",
              "    IF(",
              "        NOT ISBLANK(CenaCY) && NOT ISBLANK(CenaPY),",
              "        (CenaCY - CenaPY) * [Total Quantity],",
              "        BLANK()",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "c74d05f6-78fb-4192-b254-1503b4e38b10"
          },
          {
            "name": "Revenue PY",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Revenue PY]",
              "",
              "DAX Formula:",
              "",
              "CALCULATE(",
              "    [Total Revenue], ",
              "    SAMEPERIODLASTYEAR('Date'[Date])",
              ")"
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Revenue], ",
              "    SAMEPERIODLASTYEAR('Date'[Date])",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "6bf4a956-c1df-4cc2-afcf-5c6298f9761e"
          },
          {
            "name": "Quantity PY",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Quantity PY]",
              "",
              "DAX Formula:",
              "",
              "CALCULATE(",
              "    [Total Quantity], ",
              "    SAMEPERIODLASTYEAR('Date'[Date])",
              ")"
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Quantity], ",
              "    SAMEPERIODLASTYEAR('Date'[Date])",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "66f6b10a-a68b-46e6-8f23-e7f7234f3e62"
          },
          {
            "name": "Delta Margin",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Delta Margin]",
              "",
              "DAX Formula:",
              "[Gross Margin] - [Gross_Margin_PY]"
            ],
            "expression": "[Gross Margin] - [Gross_Margin_PY]",
            "formatString": "#,0",
            "lineageTag": "955d1a2a-3498-4e0e-90c6-b8ca308c46fe"
          },
          {
            "name": "Volume Impact2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Volume Impact2]",
              "",
              "DAX Formula:",
              "",
              "VAR MarginPctLY = DIVIDE([Gross_Margin_PY], [Revenue PY])",
              "VAR DeltaRevenue = [Total Revenue] - [Revenue PY]",
              "",
              "RETURN MarginPctLY * DeltaRevenue"
            ],
            "expression": [
              "",
              "VAR MarginPctLY = DIVIDE([Gross_Margin_PY], [Revenue PY])",
              "VAR DeltaRevenue = [Total Revenue] - [Revenue PY]",
              "",
              "RETURN MarginPctLY * DeltaRevenue"
            ],
            "formatString": "#,0",
            "lineageTag": "5bada1af-ebe9-49aa-89a6-3bfef79d3acc"
          },
          {
            "name": "Mix Impact",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Mix Impact]",
              "",
              "DAX Formula:",
              "[Delta Margin] - [Price Impact2] - [Volume Impact2]"
            ],
            "expression": "[Delta Margin] - [Price Impact2] - [Volume Impact2]",
            "formatString": "#,0",
            "lineageTag": "a558b144-0acf-49e4-a377-cbbfea77bcd2"
          },
          {
            "name": "Filter_Margin_Killers",
            "description": [
              "Business Definition: [Please provide business logic for Filter_Margin_Killers]",
              "",
              "DAX Formula:",
              "",
              "IF(",
              "    [Gross Margin %] < 0.15 && [Revenue YoY %] > 'Target Revenue YoY'[Target Revenue YoY Value],",
              "    1,",
              "    0",
              ")"
            ],
            "expression": [
              "",
              "IF(",
              "    [Gross Margin %] < 0.15 && [Revenue YoY %] > [Target Revenue YoY Value],",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "7d8d8311-bf3b-4a79-b903-dcee80bd67a8"
          },
          {
            "name": "KPI Card SVG (Gross Margin over Date + Axes) - HOLO3",
            "annotations": [
              {
                "name": "BestPracticeAnalyzer_IgnoreRules",
                "value": "{\"RuleIDs\":[\"DAX_COLUMNS_FULLY_QUALIFIED\"]}"
              }
            ],
            "dataCategory": "ImageUrl",
            "description": [
              "Business Definition: [Please provide business logic for KPI Card SVG (Gross Margin over Date + Axes) - HOLO3]",
              "",
              "DAX Formula:",
              "",
              "-- =========================",
              "-- 1. GŁÓWNE WYMIARY KARTY (Zmieniaj do woli!)",
              "-- =========================",
              "VAR CardW = 700  -- Szerokość całkowita",
              "VAR CardH = 500  -- Wysokość całkowita",
              "",
              "-- Marginesy i zmienne zależne (automatyczne skalowanie)",
              "VAR Pad = 18",
              "VAR RectW = CardW - (Pad * 2)",
              "VAR RectH = CardH - (Pad * 2)",
              "",
              "VAR TitleX = CardW / 2",
              "VAR PillW = 240",
              "VAR PillX = CardW - PillW - 40",
              "VAR ShapeX = PillX + 8",
              "VAR VsTextX = PillX + 55",
              "",
              "-- Pobranie wartości YoY do zmiennej",
              "VAR YoYValue = [Gross Margin YoY %]",
              "VAR IsPositive = YoYValue >= 0",
              "",
              "-- Dynamiczny główny kolor: Zielony jeśli na plusie, Czerwony jeśli na minusie",
              "VAR MainColor = IF(IsPositive, \"#10B981\", \"#F43F5E\")",
              "",
              "VAR Title = \"Gross Margin \"",
              "VAR BigValue = FORMAT ( [Gross Margin], \"$#,0\" )",
              "-- Dynamiczne formatowanie (z minusem lub plusem)",
              "VAR VsLabel = \"vs PY: \" & FORMAT(YoYValue, \"+0.00%;-0.00%;0%\")",
              "",
              "/* =========",
              "   Obliczanie MAX Revenue i daty",
              "   ========= */",
              "-- 1. Znajdujemy najwyższy dzienny wynik w wybranym okresie",
              "VAR _MaxDailyRevenue = MAXX(VALUES('Date'[Date]), [Gross Margin])",
              "",
              "-- 2. Szukamy konkretnej daty, w której wystąpił ten maksymalny wynik",
              "-- (Używamy MIN, aby w razie remisu - dwóch dni z tym samym wynikiem - wziąć pierwszą datę)",
              "VAR _MaxDate = ",
              "    CALCULATE(",
              "        MIN('Date'[Date]), ",
              "        FILTER(",
              "            VALUES('Date'[Date]), ",
              "            [Gross Margin] = _MaxDailyRevenue",
              "        )",
              "    )",
              "",
              "-- 3. Formatujemy wartości do wyświetlenia jako tekst",
              "VAR _FormattedMaxRev = FORMAT(_MaxDailyRevenue, \"$#,0\") -- Dodaj np. \"K\" lub \"M\" jeśli chcesz skrócić",
              "VAR _FormattedDate = FORMAT(_MaxDate, \"dd MMM yyyy\") -- Da wynik np. \"15 Jun 2023\"",
              "",
              "-- 4. Sklejamy gotową linijkę tekstu",
              "VAR Line2 = \"MAX: \" & _FormattedMaxRev & \" | \" & _FormattedDate",
              "",
              "-- =========================",
              "-- 2. LAYOUT WYKRESU (zależny od szerokości i wysokości karty)",
              "-- =========================",
              "VAR AxisX = 130",
              "VAR X0    = AxisX + 25",
              "VAR X1    = CardW - 65",
              "",
              "VAR YTop  = CardH - 220",
              "VAR YBot  = CardH - 110",
              "VAR AxisY = CardH - 90",
              "",
              "-- Dynamiczna zmiana ikony",
              "VAR _shape = ",
              "    IF(IsPositive,",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='\" & MainColor & \"'/><path d='M9 12l2 2 4-4' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>\",",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' fill='\" & MainColor & \"' viewBox='0 0 24 24'><path d='M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z'/><text x='12' y='18' font-size='16' font-family='Segoe UI' font-weight='bold' fill='white' text-anchor='middle'>!</text></svg>\"",
              "    )",
              "",
              "-- Daty w kontekście",
              "VAR DatesInScope =",
              "    CALCULATETABLE (",
              "        VALUES ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date'[Date] )",
              "    )",
              "",
              "-- Sales per dzień",
              "VAR Series0 =",
              "    ADDCOLUMNS (",
              "        DatesInScope,",
              "        \"__Sales\", CALCULATE ( [Gross Margin] )",
              "    )",
              "",
              "VAR SeriesNB = FILTER ( Series0, NOT ISBLANK ( [__Sales] ) )",
              "VAR N = COUNTROWS ( SeriesNB )",
              "",
              "-- =========================",
              "-- Skala Y: od 0",
              "-- =========================",
              "VAR MaxSales = MAXX ( SeriesNB, [__Sales] )",
              "VAR MinSales = 0",
              "VAR RangeSales = IF ( MaxSales = MinSales, 1, MaxSales - MinSales )",
              "",
              "-- indeks",
              "VAR Series1 =",
              "    ADDCOLUMNS (",
              "        SeriesNB,",
              "        \"__Idx\", RANKX ( SeriesNB, 'Date'[Date], , ASC, Dense )",
              "    )",
              "",
              "-- skalowanie do SVG",
              "VAR Series2 =",
              "    ADDCOLUMNS (",
              "        Series1,",
              "        \"__X\", X0 + DIVIDE ( ([__Idx] - 1) * (X1 - X0), MAX ( N - 1, 1 ) ),",
              "        \"__Y\", YBot - DIVIDE ( ([__Sales] - MinSales) * (YBot - YTop), RangeSales )",
              "    )",
              "",
              "-- ścieżka wykresu",
              "VAR PathD =",
              "    IF (",
              "        N >= 2,",
              "        \"M \"",
              "            & CONCATENATEX (",
              "                Series2,",
              "                FORMAT ( [__X], \"0\" ) & \" \" & FORMAT ( [__Y], \"0\" ),",
              "                \" L \",",
              "                'Date'[Date],",
              "                ASC",
              "            )",
              "    )",
              "",
              "-- =========================",
              "-- OŚ Y: ticki + etykiety + siatka",
              "-- =========================",
              "VAR YTickCount = 4",
              "VAR YIdx = GENERATESERIES ( 0, YTickCount - 1, 1 )",
              "",
              "VAR YTicks =",
              "    ADDCOLUMNS (",
              "        YIdx,",
              "        \"__y\", YBot - DIVIDE ( [Value], YTickCount - 1 ) * (YBot - YTop),",
              "        \"__label\", FORMAT ( MinSales + DIVIDE ( [Value], YTickCount - 1 ) * RangeSales, \"$#,0\" )",
              "    )",
              "",
              "VAR YAxisSVG =",
              "    CONCATENATEX (",
              "        YTicks,",
              "        \"<line x1='\" & X0 & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & X1 & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#E2E8F0' stroke-width='2' opacity='0.85'/>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & (AxisX-8) & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & (AxisX-14) & \"' y='\" & FORMAT ( [__y] + 8, \"0\" ) & \"' text-anchor='end' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        1,",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- OŚ X: etykiety dat (start / mid / end)",
              "-- =========================",
              "VAR MidI = INT ( DIVIDE ( N + 1, 2 ) )",
              "",
              "VAR XTickI =",
              "    UNION (",
              "        ROW ( \"i\", 1 ),",
              "        ROW ( \"i\", MidI ),",
              "        ROW ( \"i\", N )",
              "    )",
              "",
              "VAR XTicks =",
              "    ADDCOLUMNS (",
              "        XTickI,",
              "        \"__x\", MAXX ( FILTER ( Series2, [__Idx] = [i] ), [__X] ),",
              "        \"__label\", FORMAT ( MAXX ( FILTER ( Series2, [__Idx] = [i] ), 'Date'[Date] ), \"MMM yy\" )",
              "    )",
              "",
              "VAR XAxisSVG =",
              "    CONCATENATEX (",
              "        XTicks,",
              "        \"<line x1='\" & FORMAT ( [__x], \"0\" ) & \"' y1='\" & AxisY & \"' x2='\" & FORMAT ( [__x], \"0\" ) & \"' y2='\" & (AxisY+6) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & FORMAT ( [__x], \"0\" ) & \"' y='\" & (AxisY+32) & \"' text-anchor='middle' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        [i],",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- 3. RENDER SVG",
              "-- =========================",
              "VAR SVGraw =",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 \" & CardW & \" \" & CardH & \"'>\" &",
              "\"<defs><style>\" &",
              "\".tTitle{font-family:Segoe UI,Arial,sans-serif;font-size:34px;font-weight:700;fill:#334155;opacity:0.90;}\" &",
              "\".tBig{font-family:Segoe UI,Arial,sans-serif;font-size:54px;font-weight:900;fill:#0F172A;}\" &",
              "\".tSub{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:600;fill:#475569;opacity:0.85;}\" &",
              "\".pillT{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:800;fill:\" & MainColor & \";}\" &",
              "\"</style>\" &",
              "",
              "-- Tło bazowe",
              "\"<linearGradient id='bgHolo' x1='0' y1='0' x2='1' y2='1'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff'/>\" &",
              "\"<stop offset='40%'  stop-color='#f8fafc'/>\" &",
              "\"<stop offset='100%' stop-color='#f1f5f9'/>\" &",
              "\"</linearGradient>\" &",
              "",
              "-- Glow z lewej",
              "\"<radialGradient id='holoPearl' cx='0.15' cy='0.15' r='0.85'>\" &",
              "\"<stop offset='0%'   stop-color='#10B981' stop-opacity='0.12'/>\" &",
              "\"<stop offset='45%'  stop-color='#10B981' stop-opacity='0.03'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Glow z prawej",
              "\"<radialGradient id='holoNeon' cx='0.90' cy='0.85' r='0.90'>\" &",
              "\"<stop offset='0%'   stop-color='#F43F5E' stop-opacity='0.10'/>\" &",
              "\"<stop offset='50%'  stop-color='#1E293B' stop-opacity='0.05'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Użycie zautomatyzowanych zmiennych Marginesów (RectW, RectH)",
              "\"<clipPath id='clipCard'><rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28'/></clipPath>\" &",
              "\"<clipPath id='clipChart'><rect x='\" & X0 & \"' y='\" & YTop & \"' width='\" & (X1-X0) & \"' height='\" & (YBot-YTop) & \"'/></clipPath>\" &",
              "\"</defs>\" &",
              "",
              "-- Tło ",
              "\"<g clip-path='url(#clipCard)'>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#bgHolo)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoPearl)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoNeon)'/>\" &",
              "\"</g>\" &",
              "",
              "-- Subtelna ramka",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='none' stroke='#E2E8F0' stroke-width='2'/>\" &",
              "",
              "-- TYTUŁ WYRÓWNANY DO LEWEJ (x='70')",
              "\"<text x='70' y='70' class='tTitle'>\" & Title & \"</text>\" &",
              "\"<text x='70' y='150' class='tBig'>\" & BigValue & \"</text>\" &",
              "",
              "-- Ramka w pigułce z dynamicznym stroke i ułożeniem względem prawej",
              "\"<rect x='\" & PillX & \"' y='40' width='\" & PillW & \"' height='52' rx='20' ry='20' fill='white' stroke='\" & MainColor & \"' stroke-width='3' opacity='0.96'/>\" &",
              "",
              "-- DYNAMICZNY KSZTAŁT",
              "_shape &",
              "",
              "\"<text x='\" & VsTextX & \"' y='74' class='pillT'>\" & VsLabel & \"</text>\" &",
              "",
              "\"<text x='70' y='190' class='tSub'>\" & Line2 & \"</text>\" &",
              "",
              "-- OŚ Y",
              "\"<line x1='\" & AxisX & \"' y1='\" & (YTop) & \"' x2='\" & AxisX & \"' y2='\" & (YBot) & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "\"<path d='M \" & AxisX & \" \" & (YTop-10) & \" L \" & (AxisX-8) & \" \" & (YTop+8) & \" L \" & (AxisX+8) & \" \" & (YTop+8) & \" Z' fill='#94A3B8' opacity='0.50'/>\" &",
              "",
              "-- OŚ X",
              "\"<line x1='\" & X0 & \"' y1='\" & AxisY & \"' x2='\" & X1 & \"' y2='\" & AxisY & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "",
              "IF ( N >= 2, YAxisSVG, \"\" ) &",
              "IF ( N >= 2, XAxisSVG, \"\" ) &",
              "",
              "-- Linia trendu podpięta pod MainColor",
              "IF (",
              "    N >= 2,",
              "    \"<g clip-path='url(#clipChart)'>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='10' opacity='0.15' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "    \"</g>\",",
              "    \"<text x='70' y='\" & (YTop + 70) & \"' font-family='Segoe UI,Arial,sans-serif' font-size='18' fill='#475569' opacity='0.7'>No trend data</text>\"",
              ") &",
              "",
              "\"</svg>\"",
              "",
              "RETURN",
              "\"data:image/svg+xml;utf8,\" & SVGraw"
            ],
            "expression": [
              "",
              "-- =========================",
              "-- 1. GŁÓWNE WYMIARY KARTY (Zmieniaj do woli!)",
              "-- =========================",
              "VAR CardW = 700  -- Szerokość całkowita",
              "VAR CardH = 500  -- Wysokość całkowita",
              "",
              "-- Marginesy i zmienne zależne (automatyczne skalowanie)",
              "VAR Pad = 18",
              "VAR RectW = CardW - (Pad * 2)",
              "VAR RectH = CardH - (Pad * 2)",
              "",
              "VAR TitleX = CardW / 2",
              "VAR PillW = 240",
              "VAR PillX = CardW - PillW - 40",
              "VAR ShapeX = PillX + 8",
              "VAR VsTextX = PillX + 55",
              "",
              "-- Pobranie wartości YoY do zmiennej",
              "VAR YoYValue = [Gross Margin YoY %]",
              "VAR IsPositive = YoYValue >= 0",
              "",
              "-- Dynamiczny główny kolor: Zielony jeśli na plusie, Czerwony jeśli na minusie",
              "VAR MainColor = IF(IsPositive, \"#10B981\", \"#F43F5E\")",
              "",
              "VAR Title = \"Gross Margin \"",
              "VAR BigValue = FORMAT ( [Gross Margin], \"$#,0\" )",
              "-- Dynamiczne formatowanie (z minusem lub plusem)",
              "VAR VsLabel = \"vs PY: \" & FORMAT(YoYValue, \"+0.00%;-0.00%;0%\")",
              "",
              "/* =========",
              "   Obliczanie MAX Revenue i daty",
              "   ========= */",
              "-- 1. Znajdujemy najwyższy dzienny wynik w wybranym okresie",
              "VAR _MaxDailyRevenue = MAXX(VALUES('Date'[Date]), [Gross Margin])",
              "",
              "-- 2. Szukamy konkretnej daty, w której wystąpił ten maksymalny wynik",
              "-- (Używamy MIN, aby w razie remisu - dwóch dni z tym samym wynikiem - wziąć pierwszą datę)",
              "VAR _MaxDate = ",
              "    CALCULATE(",
              "        MIN('Date'[Date]), ",
              "        FILTER(",
              "            VALUES('Date'[Date]), ",
              "            [Gross Margin] = _MaxDailyRevenue",
              "        )",
              "    )",
              "",
              "-- 3. Formatujemy wartości do wyświetlenia jako tekst",
              "VAR _FormattedMaxRev = FORMAT(_MaxDailyRevenue, \"$#,0\") -- Dodaj np. \"K\" lub \"M\" jeśli chcesz skrócić",
              "VAR _FormattedDate = FORMAT(_MaxDate, \"dd MMM yyyy\") -- Da wynik np. \"15 Jun 2023\"",
              "",
              "-- 4. Sklejamy gotową linijkę tekstu",
              "VAR Line2 = \"MAX: \" & _FormattedMaxRev & \" | \" & _FormattedDate",
              "",
              "-- =========================",
              "-- 2. LAYOUT WYKRESU (zależny od szerokości i wysokości karty)",
              "-- =========================",
              "VAR AxisX = 130",
              "VAR X0    = AxisX + 25",
              "VAR X1    = CardW - 65",
              "",
              "VAR YTop  = CardH - 220",
              "VAR YBot  = CardH - 110",
              "VAR AxisY = CardH - 90",
              "",
              "-- Dynamiczna zmiana ikony",
              "VAR _shape = ",
              "    IF(IsPositive,",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='\" & MainColor & \"'/><path d='M9 12l2 2 4-4' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>\",",
              "        \"<svg x='\" & ShapeX & \"' y='46' width='40' height='40' fill='\" & MainColor & \"' viewBox='0 0 24 24'><path d='M12 22c1.1 0 2-.9 2-2h-4a2 2 0 002 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 00-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z'/><text x='12' y='18' font-size='16' font-family='Segoe UI' font-weight='bold' fill='white' text-anchor='middle'>!</text></svg>\"",
              "    )",
              "",
              "-- Daty w kontekście",
              "VAR DatesInScope =",
              "    CALCULATETABLE (",
              "        VALUES ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date'[Date] )",
              "    )",
              "",
              "-- Sales per dzień",
              "VAR Series0 =",
              "    ADDCOLUMNS (",
              "        DatesInScope,",
              "        \"__Sales\", CALCULATE ( [Gross Margin] )",
              "    )",
              "",
              "VAR SeriesNB = FILTER ( Series0, NOT ISBLANK ( [__Sales] ) )",
              "VAR N = COUNTROWS ( SeriesNB )",
              "",
              "-- =========================",
              "-- Skala Y: od 0",
              "-- =========================",
              "VAR MaxSales = MAXX ( SeriesNB, [__Sales] )",
              "VAR MinSales = 0",
              "VAR RangeSales = IF ( MaxSales = MinSales, 1, MaxSales - MinSales )",
              "",
              "-- indeks",
              "VAR Series1 =",
              "    ADDCOLUMNS (",
              "        SeriesNB,",
              "        \"__Idx\", RANKX ( SeriesNB, 'Date'[Date], , ASC, Dense )",
              "    )",
              "",
              "-- skalowanie do SVG",
              "VAR Series2 =",
              "    ADDCOLUMNS (",
              "        Series1,",
              "        \"__X\", X0 + DIVIDE ( ([__Idx] - 1) * (X1 - X0), MAX ( N - 1, 1 ) ),",
              "        \"__Y\", YBot - DIVIDE ( ([__Sales] - MinSales) * (YBot - YTop), RangeSales )",
              "    )",
              "",
              "-- ścieżka wykresu",
              "VAR PathD =",
              "    IF (",
              "        N >= 2,",
              "        \"M \"",
              "            & CONCATENATEX (",
              "                Series2,",
              "                FORMAT ( [__X], \"0\" ) & \" \" & FORMAT ( [__Y], \"0\" ),",
              "                \" L \",",
              "                'Date'[Date],",
              "                ASC",
              "            )",
              "    )",
              "",
              "-- =========================",
              "-- OŚ Y: ticki + etykiety + siatka",
              "-- =========================",
              "VAR YTickCount = 4",
              "VAR YIdx = GENERATESERIES ( 0, YTickCount - 1, 1 )",
              "",
              "VAR YTicks =",
              "    ADDCOLUMNS (",
              "        YIdx,",
              "        \"__y\", YBot - DIVIDE ( [Value], YTickCount - 1 ) * (YBot - YTop),",
              "        \"__label\", FORMAT ( MinSales + DIVIDE ( [Value], YTickCount - 1 ) * RangeSales, \"$#,0\" )",
              "    )",
              "",
              "VAR YAxisSVG =",
              "    CONCATENATEX (",
              "        YTicks,",
              "        \"<line x1='\" & X0 & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & X1 & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#E2E8F0' stroke-width='2' opacity='0.85'/>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & (AxisX-8) & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & (AxisX-14) & \"' y='\" & FORMAT ( [__y] + 8, \"0\" ) & \"' text-anchor='end' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        1,",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- OŚ X: etykiety dat (start / mid / end)",
              "-- =========================",
              "VAR MidI = INT ( DIVIDE ( N + 1, 2 ) )",
              "",
              "VAR XTickI =",
              "    UNION (",
              "        ROW ( \"i\", 1 ),",
              "        ROW ( \"i\", MidI ),",
              "        ROW ( \"i\", N )",
              "    )",
              "",
              "VAR XTicks =",
              "    ADDCOLUMNS (",
              "        XTickI,",
              "        \"__x\", MAXX ( FILTER ( Series2, [__Idx] = [i] ), [__X] ),",
              "        \"__label\", FORMAT ( MAXX ( FILTER ( Series2, [__Idx] = [i] ), 'Date'[Date] ), \"MMM yy\" )",
              "    )",
              "",
              "VAR XAxisSVG =",
              "    CONCATENATEX (",
              "        XTicks,",
              "        \"<line x1='\" & FORMAT ( [__x], \"0\" ) & \"' y1='\" & AxisY & \"' x2='\" & FORMAT ( [__x], \"0\" ) & \"' y2='\" & (AxisY+6) &",
              "        \"' stroke='#64748B' stroke-width='2' opacity='0.50'/>\" &",
              "        \"<text x='\" & FORMAT ( [__x], \"0\" ) & \"' y='\" & (AxisY+32) & \"' text-anchor='middle' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='22' font-weight='600' fill='#64748B' opacity='0.85'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        [i],",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- 3. RENDER SVG",
              "-- =========================",
              "VAR SVGraw =",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 \" & CardW & \" \" & CardH & \"'>\" &",
              "\"<defs><style>\" &",
              "\".tTitle{font-family:Segoe UI,Arial,sans-serif;font-size:34px;font-weight:700;fill:#334155;opacity:0.90;}\" &",
              "\".tBig{font-family:Segoe UI,Arial,sans-serif;font-size:54px;font-weight:900;fill:#0F172A;}\" &",
              "\".tSub{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:600;fill:#475569;opacity:0.85;}\" &",
              "\".pillT{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:800;fill:\" & MainColor & \";}\" &",
              "\"</style>\" &",
              "",
              "-- Tło bazowe",
              "\"<linearGradient id='bgHolo' x1='0' y1='0' x2='1' y2='1'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff'/>\" &",
              "\"<stop offset='40%'  stop-color='#f8fafc'/>\" &",
              "\"<stop offset='100%' stop-color='#f1f5f9'/>\" &",
              "\"</linearGradient>\" &",
              "",
              "-- Glow z lewej",
              "\"<radialGradient id='holoPearl' cx='0.15' cy='0.15' r='0.85'>\" &",
              "\"<stop offset='0%'   stop-color='#10B981' stop-opacity='0.12'/>\" &",
              "\"<stop offset='45%'  stop-color='#10B981' stop-opacity='0.03'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Glow z prawej",
              "\"<radialGradient id='holoNeon' cx='0.90' cy='0.85' r='0.90'>\" &",
              "\"<stop offset='0%'   stop-color='#F43F5E' stop-opacity='0.10'/>\" &",
              "\"<stop offset='50%'  stop-color='#1E293B' stop-opacity='0.05'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Użycie zautomatyzowanych zmiennych Marginesów (RectW, RectH)",
              "\"<clipPath id='clipCard'><rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28'/></clipPath>\" &",
              "\"<clipPath id='clipChart'><rect x='\" & X0 & \"' y='\" & YTop & \"' width='\" & (X1-X0) & \"' height='\" & (YBot-YTop) & \"'/></clipPath>\" &",
              "\"</defs>\" &",
              "",
              "-- Tło ",
              "\"<g clip-path='url(#clipCard)'>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#bgHolo)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoPearl)'/>\" &",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='url(#holoNeon)'/>\" &",
              "\"</g>\" &",
              "",
              "-- Subtelna ramka",
              "\"<rect x='\" & Pad & \"' y='\" & Pad & \"' width='\" & RectW & \"' height='\" & RectH & \"' rx='28' ry='28' fill='none' stroke='#E2E8F0' stroke-width='2'/>\" &",
              "",
              "-- TYTUŁ WYRÓWNANY DO LEWEJ (x='70')",
              "\"<text x='70' y='70' class='tTitle'>\" & Title & \"</text>\" &",
              "\"<text x='70' y='150' class='tBig'>\" & BigValue & \"</text>\" &",
              "",
              "-- Ramka w pigułce z dynamicznym stroke i ułożeniem względem prawej",
              "\"<rect x='\" & PillX & \"' y='40' width='\" & PillW & \"' height='52' rx='20' ry='20' fill='white' stroke='\" & MainColor & \"' stroke-width='3' opacity='0.96'/>\" &",
              "",
              "-- DYNAMICZNY KSZTAŁT",
              "_shape &",
              "",
              "\"<text x='\" & VsTextX & \"' y='74' class='pillT'>\" & VsLabel & \"</text>\" &",
              "",
              "\"<text x='70' y='190' class='tSub'>\" & Line2 & \"</text>\" &",
              "",
              "-- OŚ Y",
              "\"<line x1='\" & AxisX & \"' y1='\" & (YTop) & \"' x2='\" & AxisX & \"' y2='\" & (YBot) & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "\"<path d='M \" & AxisX & \" \" & (YTop-10) & \" L \" & (AxisX-8) & \" \" & (YTop+8) & \" L \" & (AxisX+8) & \" \" & (YTop+8) & \" Z' fill='#94A3B8' opacity='0.50'/>\" &",
              "",
              "-- OŚ X",
              "\"<line x1='\" & X0 & \"' y1='\" & AxisY & \"' x2='\" & X1 & \"' y2='\" & AxisY & \"' stroke='#94A3B8' stroke-width='3' opacity='0.50'/>\" &",
              "",
              "IF ( N >= 2, YAxisSVG, \"\" ) &",
              "IF ( N >= 2, XAxisSVG, \"\" ) &",
              "",
              "-- Linia trendu podpięta pod MainColor",
              "IF (",
              "    N >= 2,",
              "    \"<g clip-path='url(#clipChart)'>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='10' opacity='0.15' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='\" & MainColor & \"' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "    \"</g>\",",
              "    \"<text x='70' y='\" & (YTop + 70) & \"' font-family='Segoe UI,Arial,sans-serif' font-size='18' fill='#475569' opacity='0.7'>No trend data</text>\"",
              ") &",
              "",
              "\"</svg>\"",
              "",
              "RETURN",
              "\"data:image/svg+xml;utf8,\" & SVGraw"
            ],
            "formatString": "#,0",
            "lineageTag": "1467a8a0-cced-4ca2-b8ba-fadefc073493"
          },
          {
            "name": "Gross Margin YoY %",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Gross Margin YoY %]",
              "",
              "DAX Formula:",
              "",
              "VAR _Current = [Gross Margin]",
              "VAR _PreviousYear = CALCULATE([Gross Margin], SAMEPERIODLASTYEAR('Date'[Date]))",
              "RETURN",
              "DIVIDE(_Current - _PreviousYear, _PreviousYear, 0)"
            ],
            "expression": [
              "",
              "VAR _Current = [Gross Margin]",
              "VAR _PreviousYear = CALCULATE([Gross Margin], SAMEPERIODLASTYEAR('Date'[Date]))",
              "RETURN",
              "DIVIDE(_Current - _PreviousYear, _PreviousYear, 0)"
            ],
            "formatString": "#,0",
            "lineageTag": "88353114-7076-4320-8882-453034639417"
          },
          {
            "name": "Scatter Color by Target",
            "description": [
              "Business Definition: [Please provide business logic for Scatter Color by Target]",
              "",
              "DAX Formula:",
              "",
              "VAR _CurrentYoY = [Revenue YoY %] -- Twoja miara z osi X",
              "VAR _TargetYoY = [Target Revenue YoY Value] -- Wygenerowana miara z Twojego parametru",
              "",
              "RETURN",
              "IF(",
              "    _CurrentYoY >= _TargetYoY, ",
              "    \"#94A3B8\", -- Klienci spełniający cel (np. uspokajający stalowy/szary)",
              "    \"#F43F5E\"  -- Klienci poniżej celu (np. ostrzegawczy czerwony, jak Client 19 i 44)",
              ")"
            ],
            "expression": [
              "",
              "VAR _CurrentYoY = [Revenue YoY %] -- Twoja miara z osi X",
              "VAR _TargetYoY = [Target Revenue YoY Value] -- Wygenerowana miara z Twojego parametru",
              "",
              "RETURN",
              "IF(",
              "    _CurrentYoY >= _TargetYoY, ",
              "    \"#94A3B8\", -- Klienci spełniający cel (np. uspokajający stalowy/szary)",
              "    \"#F43F5E\"  -- Klienci poniżej celu (np. ostrzegawczy czerwony, jak Client 19 i 44)",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "e9747cf6-b6af-4755-8c21-e4577ea52223"
          },
          {
            "name": "Filters Applied",
            "description": [
              "Business Definition: [Please provide business logic for Filters Applied]",
              "",
              "DAX Formula:",
              "",
              "",
              "-- Date",
              "IF (",
              "    ISFILTERED ( 'Date'[Date] ),",
              "    VAR items = VALUES ( 'Date'[Date] )",
              "    VAR itemscombined = CONCATENATEX ( items, 'Date'[Date], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
              "IF (",
              "    ISFILTERED ( 'Date'[Year] ),",
              "    VAR items = VALUES ( 'Date'[Year] )",
              "    VAR itemscombined = CONCATENATEX ( items, 'Date'[Year], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
              "IF (",
              "    ISFILTERED ( 'Date'[Month Name] ),",
              "    VAR items = VALUES ( 'Date'[Month Name] )",
              "    VAR itemscombined = CONCATENATEX ( items, 'Date'[Month Name], \", \" )",
              "    RETURN   itemscombined & UNICHAR(10)",
              ") &",
              "",
              "-- Dim_Customer",
              "IF (",
              "    ISFILTERED ( Dim_Customer[Customer_Name] ),",
              "    VAR items = VALUES ( Dim_Customer[Customer_Name] )",
              "    VAR itemscombined = CONCATENATEX ( items, Dim_Customer[Customer_Name], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
              "IF (",
              "    ISFILTERED ( Dim_Customer[Region] ),",
              "    VAR items = VALUES ( Dim_Customer[Region] )",
              "    VAR itemscombined = CONCATENATEX ( items, Dim_Customer[Region], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
              "IF (",
              "    ISFILTERED ( Dim_Customer[Segment] ),",
              "    VAR items = VALUES ( Dim_Customer[Segment] )",
              "    VAR itemscombined = CONCATENATEX ( items, Dim_Customer[Segment], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
              "-- Dim_Product",
              "IF (",
              "    ISFILTERED ( Dim_Product[Product_Name] ),",
              "    VAR items = VALUES ( Dim_Product[Product_Name] )",
              "    VAR itemscombined = CONCATENATEX ( items, Dim_Product[Product_Name], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
              "IF (",
              "    ISFILTERED ( Dim_Product[Tier] ),",
              "    VAR items = VALUES ( Dim_Product[Tier] )",
              "    VAR itemscombined = CONCATENATEX ( items, Dim_Product[Tier], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
              "IF (",
              "    ISFILTERED ( Dim_Product[Category] ),",
              "    VAR items = VALUES ( Dim_Product[Category] )",
              "    VAR itemscombined = CONCATENATEX ( items, Dim_Product[Category], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ")",
              ""
            ],
            "expression": [
              "",
              "",
              "-- Date",
              "IF (",
              "    ISFILTERED ( 'Date'[Date] ),",
              "    VAR items = VALUES ( 'Date'[Date] )",
              "    VAR itemscombined = CONCATENATEX ( items, 'Date'[Date], \", \" )",
              "    RETURN  itemscombined & UNICHAR(10)",
              ") &",
