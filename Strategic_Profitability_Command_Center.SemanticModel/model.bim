          {
            "name": "KPI Card SVG (Sales over Date + Axes) - HOLO",
            "annotations": [
              {
                "name": "BestPracticeAnalyzer_IgnoreRules",
                "value": "{\"RuleIDs\":[\"DAX_COLUMNS_FULLY_QUALIFIED\"]}"
              }
            ],
            "dataCategory": "WebUrl",
            "description": [
              "Business Definition: [Please provide business logic for KPI Card SVG (Sales over Date + Axes) - HOLO]",
              "",
              "DAX Formula:",
              "",
              "VAR Title = \"Sales\"",
              "VAR BigValue = FORMAT ( [Total Revenue], \"$#,0\" )",
              "VAR VsLabel = \"vs PY: -25%\"",
              "VAR Line2 = \"CM June: 35,7777 | PM May: 35,000\"",
              "",
              "-- =========================",
              "-- LAYOUT (miejsce na etykiety osi Y)",
              "-- =========================",
              "VAR AxisX = 130",
              "VAR X0    = AxisX + 25",
              "VAR X1    = 735",
              "",
              "VAR YTop  = 230",
              "VAR YBot  = 340",
              "",
              "VAR AxisY = 360",
              "",
              "-- Daty w kontekście",
              "VAR DatesInScope =",
              "    CALCULATETABLE (",
              "        VALUES ( 'Date'[Date] ),",
              "        ALLSELECTED ( 'Date'[Date] )",
              "    )",
              "",
              "-- Sales per dzień",
              "VAR Series0 =",
              "    ADDCOLUMNS (",
              "        DatesInScope,",
              "        \"__Sales\", CALCULATE ( [Total Revenue] )",
              "    )",
              "",
              "VAR SeriesNB = FILTER ( Series0, NOT ISBLANK ( [__Sales] ) )",
              "VAR N = COUNTROWS ( SeriesNB )",
              "",
              "-- =========================",
              "-- Skala Y: od 0",
              "-- =========================",
              "VAR MaxSales = MAXX ( SeriesNB, [__Sales] )",
              "VAR MinSales = 0",
              "VAR RangeSales = IF ( MaxSales = MinSales, 1, MaxSales - MinSales )",
              "",
              "-- indeks",
              "VAR Series1 =",
              "    ADDCOLUMNS (",
              "        SeriesNB,",
              "        \"__Idx\", RANKX ( SeriesNB, 'Date'[Date], , ASC, Dense )",
              "    )",
              "",
              "-- skalowanie do SVG",
              "VAR Series2 =",
              "    ADDCOLUMNS (",
              "        Series1,",
              "        \"__X\",",
              "            X0 + DIVIDE ( ([__Idx] - 1) * (X1 - X0), MAX ( N - 1, 1 ) ),",
              "        \"__Y\",",
              "            YBot - DIVIDE ( ([__Sales] - MinSales) * (YBot - YTop), RangeSales )",
              "    )",
              "",
              "-- ścieżka wykresu",
              "VAR PathD =",
              "    IF (",
              "        N >= 2,",
              "        \"M \"",
              "            & CONCATENATEX (",
              "                Series2,",
              "                FORMAT ( [__X], \"0\" ) & \" \" & FORMAT ( [__Y], \"0\" ),",
              "                \" L \",",
              "                'Date'[Date],",
              "                ASC",
              "            )",
              "    )",
              "",
              "-- =========================",
              "-- OŚ Y: ticki + etykiety + siatka",
              "-- =========================",
              "VAR YTickCount = 4",
              "VAR YIdx = GENERATESERIES ( 0, YTickCount - 1, 1 )",
              "",
              "VAR YTicks =",
              "    ADDCOLUMNS (",
              "        YIdx,",
              "        \"__y\", YBot - DIVIDE ( [Value], YTickCount - 1 ) * (YBot - YTop),",
              "        \"__label\", FORMAT ( MinSales + DIVIDE ( [Value], YTickCount - 1 ) * RangeSales, \"$#,0\" )",
              "    )",
              "",
              "VAR YAxisSVG =",
              "    CONCATENATEX (",
              "        YTicks,",
              "        \"<line x1='\" & X0 & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & X1 & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#e6e6e6' stroke-width='2' opacity='0.85'/>\" &",
              "        \"<line x1='\" & AxisX & \"' y1='\" & FORMAT ( [__y], \"0\" ) & \"' x2='\" & (AxisX-8) & \"' y2='\" & FORMAT ( [__y], \"0\" ) &",
              "        \"' stroke='#2b2b2b' stroke-width='3' opacity='0.50'/>\" &",
              "        \"<text x='\" & (AxisX-12) & \"' y='\" & FORMAT ( [__y] + 8, \"0\" ) & \"' text-anchor='end' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='16' font-weight='600' fill='#2b2b2b' opacity='0.65'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        1,",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- OŚ X: etykiety dat (start / mid / end)",
              "-- =========================",
              "VAR MidI = INT ( DIVIDE ( N + 1, 2 ) )",
              "",
              "VAR XTickI =",
              "    UNION (",
              "        ROW ( \"i\", 1 ),",
              "        ROW ( \"i\", MidI ),",
              "        ROW ( \"i\", N )",
              "    )",
              "",
              "VAR XTicks =",
              "    ADDCOLUMNS (",
              "        XTickI,",
              "        \"__x\", MAXX ( FILTER ( Series2, [__Idx] = [i] ), [__X] ),",
              "        \"__label\", FORMAT ( MAXX ( FILTER ( Series2, [__Idx] = [i] ), 'Date'[Date] ), \"MMM yy\" )",
              "    )",
              "",
              "VAR XAxisSVG =",
              "    CONCATENATEX (",
              "        XTicks,",
              "        \"<line x1='\" & FORMAT ( [__x], \"0\" ) & \"' y1='\" & AxisY & \"' x2='\" & FORMAT ( [__x], \"0\" ) & \"' y2='\" & (AxisY+8) &",
              "        \"' stroke='#2b2b2b' stroke-width='3' opacity='0.45'/>\" &",
              "        \"<text x='\" & FORMAT ( [__x], \"0\" ) & \"' y='\" & (AxisY+30) & \"' text-anchor='middle' \" &",
              "        \"font-family='Segoe UI,Arial,sans-serif' font-size='16' font-weight='600' fill='#2b2b2b' opacity='0.65'>\" &",
              "        [__label] & \"</text>\",",
              "        \"\",",
              "        [i],",
              "        ASC",
              "    )",
              "",
              "-- =========================",
              "-- SVG (HOLO / Iridescent)",
              "-- =========================",
              "VAR SVGraw =",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450'>\" &",
              "\"<defs><style>\" &",
              "\".tTitle{font-family:Segoe UI,Arial,sans-serif;font-size:34px;font-weight:750;fill:#1f1f1f;opacity:0.86;}\" &",
              "\".tBig{font-family:Segoe UI,Arial,sans-serif;font-size:54px;font-weight:900;fill:#151515;}\" &",
              "\".tSub{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:700;fill:#1f1f1f;opacity:0.82;}\" &",
              "\".pillT{font-family:Segoe UI,Arial,sans-serif;font-size:22px;font-weight:900;fill:#d84a4a;}\" &",
              "\"</style>\" &",
              "",
              "-- Iridescent / holo gradient (wielokolorowy, perłowy)",
              "\"<linearGradient id='bgHolo' x1='0' y1='0' x2='1' y2='1'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff'/>\" &",
              "\"<stop offset='18%'  stop-color='#e9fff8'/>\" &",
              "\"<stop offset='38%'  stop-color='#e8f0ff'/>\" &",
              "\"<stop offset='58%'  stop-color='#ffe8fb'/>\" &",
              "\"<stop offset='78%'  stop-color='#fff2da'/>\" &",
              "\"<stop offset='100%' stop-color='#f4f6ff'/>\" &",
              "\"</linearGradient>\" &",
              "",
              "-- Mocniejszy highlight (lewy-górny) – “perła”",
              "\"<radialGradient id='holoPearl' cx='0.20' cy='0.18' r='0.90'>\" &",
              "\"<stop offset='0%'   stop-color='#ffffff' stop-opacity='0.90'/>\" &",
              "\"<stop offset='38%'  stop-color='#ffffff' stop-opacity='0.22'/>\" &",
              "\"<stop offset='100%' stop-color='#ffffff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "-- Neonowa poświata (prawy-dolny) – delikatna, ale “wow”",
              "\"<radialGradient id='holoNeon' cx='0.92' cy='0.80' r='0.95'>\" &",
              "\"<stop offset='0%'   stop-color='#7c4dff' stop-opacity='0.20'/>\" &",
              "\"<stop offset='45%'  stop-color='#00d4ff' stop-opacity='0.12'/>\" &",
              "\"<stop offset='100%' stop-color='#00d4ff' stop-opacity='0'/>\" &",
              "\"</radialGradient>\" &",
              "",
              "\"<clipPath id='clipCard'><rect x='18' y='18' width='764' height='414' rx='34' ry='34'/></clipPath>\" &",
              "\"<clipPath id='clipChart'><rect x='\" & X0 & \"' y='\" & YTop & \"' width='\" & (X1-X0) & \"' height='\" & (YBot-YTop) & \"'/></clipPath>\" &",
              "\"</defs>\" &",
              "",
              "-- Tło (warstwy holo)",
              "\"<g clip-path='url(#clipCard)'>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='34' ry='34' fill='url(#bgHolo)'/>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='34' ry='34' fill='url(#holoPearl)'/>\" &",
              "\"<rect x='18' y='18' width='764' height='414' rx='34' ry='34' fill='url(#holoNeon)'/>\" &",
              "\"</g>\" &",
              "",
              "-- Ramka (trochę mocniejsza, żeby “ekstrawagancja” wyglądała premium)",
              "\"<rect x='18' y='18' width='764' height='414' rx='34' ry='34' fill='none' stroke='#d9d9d9' stroke-width='3'/>\" &",
              "",
              "\"<text x='400' y='70' text-anchor='middle' class='tTitle'>\" & Title & \"</text>\" &",
              "\"<text x='70' y='150' class='tBig'>\" & BigValue & \"</text>\" &",
              "",
              "\"<rect x='520' y='40' width='235' height='52' rx='20' ry='20' fill='white' stroke='#d84a4a' stroke-width='4' opacity='0.96'/>\" &",
              "\"<circle cx='548' cy='66' r='16' fill='#d84a4a' stroke='#d84a4a' stroke-width='4' opacity='0.96'/>\"  &",
              "\"<text x='575' y='74' class='pillT'>\" & VsLabel & \"</text>\" &",
              "",
              "\"<text x='70' y='190' class='tSub'>\" & Line2 & \"</text>\" &",
              "",
              "-- OŚ Y",
              "\"<line x1='\" & AxisX & \"' y1='\" & (YTop) & \"' x2='\" & AxisX & \"' y2='\" & (YBot) & \"' stroke='#2b2b2b' stroke-width='4' opacity='0.62'/>\" &",
              "\"<path d='M \" & AxisX & \" \" & (YTop-10) & \" L \" & (AxisX-10) & \" \" & (YTop+8) & \" L \" & (AxisX+10) & \" \" & (YTop+8) & \" Z' fill='#2b2b2b' opacity='0.62'/>\" &",
              "",
              "-- OŚ X",
              "\"<line x1='\" & X0 & \"' y1='\" & AxisY & \"' x2='\" & X1 & \"' y2='\" & AxisY & \"' stroke='#2b2b2b' stroke-width='3' opacity='0.48'/>\" &",
              "",
              "IF ( N >= 2, YAxisSVG, \"\" ) &",
              "IF ( N >= 2, XAxisSVG, \"\" ) &",
              "",
              "-- Linia trendu (clip do chart area)",
              "IF (",
              "    N >= 2,",
              "    \"<g clip-path='url(#clipChart)'>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='#d84a4a' stroke-width='10' opacity='0.18' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "        \"<path d='\" & PathD & \"' fill='none' stroke='#d84a4a' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>\" &",
              "    \"</g>\",",
              "    \"<text x='70' y='300' font-family='Segoe UI,Arial,sans-serif' font-size='18' fill='#2b2b2b' opacity='0.7'>No trend data</text>\"",
              ") &",
              "",
              "\"</svg>\"",
              "",
