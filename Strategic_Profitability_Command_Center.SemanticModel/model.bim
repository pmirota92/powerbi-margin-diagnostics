          {
            "name": "Waterfall Value",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Waterfall Value]",
              "",
              "DAX Formula:",
              "",
              "VAR _SelectedLabel = SELECTEDVALUE('_Bridge_Logic'[Label])",
              "RETURN",
              "    SWITCH( _SelectedLabel,",
              "        \"Margin LY\", [Margin % LY] * [Revenue LY], ",
              "        \"Volume Impact\", [Volume Impact],",
              "        \"Price Impact\", [Price Impact],",
              "        \"Cost Impact\", [Cost Impact],",
              "        BLANK()",
              "    )"
            ],
            "expression": [
              "",
              "VAR _SelectedLabel = SELECTEDVALUE('_Bridge_Logic'[Label])",
              "RETURN",
              "    SWITCH( _SelectedLabel,",
              "        \"Margin LY\", [Margin % LY] * [Revenue LY], ",
              "        \"Volume Impact\", [Volume Impact],",
              "        \"Price Impact\", [Price Impact],",
              "        \"Cost Impact\", [Cost Impact],",
              "        BLANK()",
              "    )"
            ],
            "formatString": "#,0",
            "lineageTag": "f3bebbf2-1af6-452c-a0c2-05f5e3be5dd0"
          },
          {
            "name": "Dynamic Upsell Suggestion",
            "description": [
              "Business Definition: [Please provide business logic for Dynamic Upsell Suggestion]",
              "",
              "DAX Formula:",
              "",
              "IF (",
              "    NOT HASONEVALUE('Dim_Product'[Product_Name]) || [Total Revenue] = 0,",
              "    \"No data for this selection\",",
              "    ",
              "    VAR _CurrentProduct = SELECTEDVALUE('Dim_Product'[Product_Name])",
              "    VAR _CurrentCategory = SELECTEDVALUE('Dim_Product'[Category])",
              "    -- Używamy Targetu obecnego produktu, żeby porównanie było sprawiedliwe",
              "    VAR _CurrentTarget = SELECTEDVALUE('Dim_Product'[Target_Margin_%])",
              "",
              "    -- Szukamy lidera kategorii w kolumnie Target_Margin_% (nie w miarach sprzedaży!)",
              "    VAR _BestInClassTable = ",
              "        TOPN(",
              "            1,",
              "            FILTER(",
              "                ALL('Dim_Product'),",
              "                'Dim_Product'[Category] = _CurrentCategory && ",
              "                'Dim_Product'[Product_Name] <> _CurrentProduct",
              "            ),",
              "            'Dim_Product'[Target_Margin_%], DESC",
              "        )",
              "",
              "    VAR _AlternativeName = MAXX(_BestInClassTable, 'Dim_Product'[Product_Name])",
              "    VAR _AlternativeTarget = MAXX(_BestInClassTable, 'Dim_Product'[Target_Margin_%])",
              "",
              "    RETURN",
              "    IF(",
              "        _AlternativeTarget > _CurrentTarget,",
              "        \"Suggest: \" & _AlternativeName & \" (\" & FORMAT(_AlternativeTarget, \"0%\") & \" Target)\",",
              "        \"Optimal product for this category\"",
              "    )",
              ")"
            ],
            "expression": [
              "",
              "IF (",
              "    NOT HASONEVALUE('Dim_Product'[Product_Name]) || [Total Revenue] = 0,",
              "    \"No data for this selection\",",
              "    ",
              "    VAR _CurrentProduct = SELECTEDVALUE('Dim_Product'[Product_Name])",
              "    VAR _CurrentCategory = SELECTEDVALUE('Dim_Product'[Category])",
              "    -- Używamy Targetu obecnego produktu, żeby porównanie było sprawiedliwe",
              "    VAR _CurrentTarget = SELECTEDVALUE('Dim_Product'[Target_Margin_%])",
              "",
              "    -- Szukamy lidera kategorii w kolumnie Target_Margin_% (nie w miarach sprzedaży!)",
              "    VAR _BestInClassTable = ",
              "        TOPN(",
              "            1,",
              "            FILTER(",
              "                ALL('Dim_Product'),",
              "                'Dim_Product'[Category] = _CurrentCategory && ",
              "                'Dim_Product'[Product_Name] <> _CurrentProduct",
              "            ),",
              "            'Dim_Product'[Target_Margin_%], DESC",
              "        )",
              "",
              "    VAR _AlternativeName = MAXX(_BestInClassTable, 'Dim_Product'[Product_Name])",
              "    VAR _AlternativeTarget = MAXX(_BestInClassTable, 'Dim_Product'[Target_Margin_%])",
              "",
              "    RETURN",
              "    IF(",
              "        _AlternativeTarget > _CurrentTarget,",
              "        \"Suggest: \" & _AlternativeName & \" (\" & FORMAT(_AlternativeTarget, \"0%\") & \" Target)\",",
              "        \"Optimal product for this category\"",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "016bc614-7eb1-44a0-8e80-a18d21e2b37e"
          },
          {
            "name": "Opportunity Gap (Dynamic)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Opportunity Gap (Dynamic)]",
              "",
              "DAX Formula:",
              "",
              "-- Zabezpieczenie: Liczymy tylko, gdy wybrany jest jeden produkt i mamy jakąś sprzedaż",
              "IF (",
              "    NOT HASONEVALUE('Dim_Product'[Product_Name]) || [Total Revenue] = 0,",
              "    0,",
              "    ",
              "    VAR _CurrentProduct = SELECTEDVALUE('Dim_Product'[Product_Name])",
              "    VAR _CurrentCategory = SELECTEDVALUE('Dim_Product'[Category])",
              "    VAR _CurrentMarginAmount = [Gross Margin]",
              "",
              "    -- 1. Szukamy marży % najlepszego produktu w kategorii na podstawie TARGETU",
              "    VAR _BestTargetMarginPct = ",
              "        CALCULATE(",
              "            MAX('Dim_Product'[Target_Margin_%]),",
              "            TOPN(",
              "                1,",
              "                FILTER(",
              "                    ALL('Dim_Product'),",
              "                    'Dim_Product'[Category] = _CurrentCategory && ",
              "                    'Dim_Product'[Product_Name] <> _CurrentProduct",
              "                ),",
              "                'Dim_Product'[Target_Margin_%], DESC",
              "            )",
              "        )",
              "",
              "    -- 2. Obliczamy potencjał: (Nasz obecny przychód * target lidera)",
              "    VAR _PotentialMarginAmount = [Total Revenue] * _BestTargetMarginPct",
              "",
              "    -- 3. Wynik to różnica (tylko jeśli potencjał jest większy od obecnego zarobku)",
              "    RETURN",
              "    IF(",
              "        _PotentialMarginAmount > _CurrentMarginAmount,",
              "        _PotentialMarginAmount - _CurrentMarginAmount,",
              "        0",
              "    )",
              ")"
            ],
            "expression": [
              "",
              "-- Zabezpieczenie: Liczymy tylko, gdy wybrany jest jeden produkt i mamy jakąś sprzedaż",
              "IF (",
              "    NOT HASONEVALUE('Dim_Product'[Product_Name]) || [Total Revenue] = 0,",
              "    0,",
              "    ",
              "    VAR _CurrentProduct = SELECTEDVALUE('Dim_Product'[Product_Name])",
              "    VAR _CurrentCategory = SELECTEDVALUE('Dim_Product'[Category])",
              "    VAR _CurrentMarginAmount = [Gross Margin]",
              "",
              "    -- 1. Szukamy marży % najlepszego produktu w kategorii na podstawie TARGETU",
              "    VAR _BestTargetMarginPct = ",
              "        CALCULATE(",
              "            MAX('Dim_Product'[Target_Margin_%]),",
              "            TOPN(",
              "                1,",
              "                FILTER(",
              "                    ALL('Dim_Product'),",
              "                    'Dim_Product'[Category] = _CurrentCategory && ",
              "                    'Dim_Product'[Product_Name] <> _CurrentProduct",
              "                ),",
              "                'Dim_Product'[Target_Margin_%], DESC",
              "            )",
              "        )",
              "",
              "    -- 2. Obliczamy potencjał: (Nasz obecny przychód * target lidera)",
              "    VAR _PotentialMarginAmount = [Total Revenue] * _BestTargetMarginPct",
              "",
              "    -- 3. Wynik to różnica (tylko jeśli potencjał jest większy od obecnego zarobku)",
              "    RETURN",
              "    IF(",
              "        _PotentialMarginAmount > _CurrentMarginAmount,",
              "        _PotentialMarginAmount - _CurrentMarginAmount,",
              "        0",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "fbf75a91-fcd7-486c-892c-c6ceaa2860bf"
          },
          {
            "name": "Margin Growth Chip SVG",
            "dataCategory": "ImageUrl",
            "description": [
              "Business Definition: [Please provide business logic for Margin Growth Chip SVG]",
              "",
              "DAX Formula:",
              "",
              "VAR _Current = [Gross Margin %]",
              "VAR _Previous = [Gross Margin % PY]",
              "VAR _Delta = _Current - _Previous",
              "VAR _DeltaPct = DIVIDE(_Delta, _Previous, 0)",
              "",
              "-- Kolory z Twojej palety Professional",
              "VAR _ColorEmerald = \"#10B981\" -- Wzrost",
              "VAR _ColorRose = \"#F43F5E\"    -- Spadek",
              "VAR _ColorNeutral = \"#64748B\" -- Brak zmian",
              "",
              "-- Logika ikon i kolorów",
              "VAR _StatusColor = IF(_Delta > 0, _ColorEmerald, IF(_Delta < 0, _ColorRose, _ColorNeutral))",
              "VAR _BgColor = _StatusColor & \"15\" -- Dodajemy 15% przezroczystości do tła (kod HEX + 15)",
              "",
              "-- Ikona Arrow Up / Down (SVG Path)",
              "VAR _IconPath = IF(_Delta > 0, ",
              "    \"M1 7l5-5 5 5M6 2v12\", -- Strzałka w górę",
              "    \"M1 7l5 5 5-5M6 12V2\"  -- Strzałka w dół",
              ")",
              "",
              "VAR _SVG = ",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 40'>\" &",
              "  \"\" &",
              "  \"<rect x='2' y='2' width='130' height='36' rx='18' fill='\" & _BgColor & \"' stroke='\" & _StatusColor & \"' stroke-width='1.5'/>\" &",
              "  ",
              "  \"\" &",
              "  \"<circle cx='20' cy='20' r='10' fill='\" & _StatusColor & \"' fill-opacity='0.2'/>\" &",
              "  \"<path d='\" & _IconPath & \"' fill='none' stroke='\" & _StatusColor & \"' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' transform='translate(14, 13) scale(1)'/>\" &",
              "  ",
              "  \"\" &",
              "  \"<text x='40' y='25' font-family='Segoe UI, Arial' font-size='14' font-weight='600' fill='\" & _StatusColor & \"'>\" & ",
              "    IF(_Delta > 0, \"+\", \"\") & FORMAT(_DeltaPct, \"0.0%\") & \" vs. PY\" & ",
              "  \"</text>\" &",
              "\"</svg>\"",
              "",
              "return _SVG"
            ],
            "expression": [
              "",
              "VAR _Current = [Gross Margin %]",
              "VAR _Previous = [Gross Margin % PY]",
              "VAR _Delta = _Current - _Previous",
              "VAR _DeltaPct = DIVIDE(_Delta, _Previous, 0)",
              "",
              "-- Kolory z Twojej palety Professional",
              "VAR _ColorEmerald = \"#10B981\" -- Wzrost",
              "VAR _ColorRose = \"#F43F5E\"    -- Spadek",
              "VAR _ColorNeutral = \"#64748B\" -- Brak zmian",
              "",
              "-- Logika ikon i kolorów",
              "VAR _StatusColor = IF(_Delta > 0, _ColorEmerald, IF(_Delta < 0, _ColorRose, _ColorNeutral))",
              "VAR _BgColor = _StatusColor & \"15\" -- Dodajemy 15% przezroczystości do tła (kod HEX + 15)",
              "",
              "-- Ikona Arrow Up / Down (SVG Path)",
              "VAR _IconPath = IF(_Delta > 0, ",
              "    \"M1 7l5-5 5 5M6 2v12\", -- Strzałka w górę",
              "    \"M1 7l5 5 5-5M6 12V2\"  -- Strzałka w dół",
              ")",
              "",
              "VAR _SVG = ",
              "\"data:image/svg+xml;utf8,\" & ",
              "\"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 40'>\" &",
              "  \"\" &",
              "  \"<rect x='2' y='2' width='130' height='36' rx='18' fill='\" & _BgColor & \"' stroke='\" & _StatusColor & \"' stroke-width='1.5'/>\" &",
              "  ",
              "  \"\" &",
              "  \"<circle cx='20' cy='20' r='10' fill='\" & _StatusColor & \"' fill-opacity='0.2'/>\" &",
              "  \"<path d='\" & _IconPath & \"' fill='none' stroke='\" & _StatusColor & \"' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' transform='translate(14, 13) scale(1)'/>\" &",
              "  ",
              "  \"\" &",
              "  \"<text x='40' y='25' font-family='Segoe UI, Arial' font-size='14' font-weight='600' fill='\" & _StatusColor & \"'>\" & ",
              "    IF(_Delta > 0, \"+\", \"\") & FORMAT(_DeltaPct, \"0.0%\") & \" vs. PY\" & ",
              "  \"</text>\" &",
              "\"</svg>\"",
              "",
              "return _SVG"
            ],
            "formatString": "#,0",
            "lineageTag": "df186f70-e9fb-4a4f-b416-9548aaf85dc1"
          },
