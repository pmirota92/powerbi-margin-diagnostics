          {
            "name": "Margin Health Status",
            "description": [
              "Business Definition: [Please provide business logic for Margin Health Status]",
              "",
              "DAX Formula:",
              "",
              "        VAR _Var = [Margin Variance to Target]",
              "        RETURN ",
              "            SWITCH( TRUE(),",
              "                ISBLANK(_Var), \"⚪\",",
              "                _Var >= 0, \"🟢 Healthy\",",
              "                _Var > -0.05, \"🟡 Warning\",",
              "                \"🔴 Critical\"",
              "            )"
            ],
            "expression": [
              "",
              "        VAR _Var = [Margin Variance to Target]",
              "        RETURN ",
              "            SWITCH( TRUE(),",
              "                ISBLANK(_Var), \"⚪\",",
              "                _Var >= 0, \"🟢 Healthy\",",
              "                _Var > -0.05, \"🟡 Warning\",",
              "                \"🔴 Critical\"",
