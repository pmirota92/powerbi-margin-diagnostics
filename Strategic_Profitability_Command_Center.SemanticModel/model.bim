              "        VAR _label = IF(_val >= 1000000, FORMAT(_val/1000000, \"#.0\") & \"M\", IF(_val >= 1000, FORMAT(_val/1000, \"#\") & \"k\", FORMAT(_val, \"0\")))",
              "        RETURN",
              "        \"<line x1='\" & _PlotX & \"' y1='\" & _yPos & \"' x2='\" & (_PlotX + _PlotW) & \"' y2='\" & _yPos & \"' stroke='\" & _GridC & \"' stroke-width='1'/>\" &",
              "        \"<text x='\" & (_PlotX - 8) & \"' y='\" & (_yPos + 4) & \"' text-anchor='end' fill='\" & _TextSub & \"' font-size='10' font-family='Segoe UI'>\" & _label & \"</text>\"",
              "    )",
              "",
              "-- Etykiety X: Pierwszy i Ostatni miesiąc",
              "VAR _XTicks = ",
              "    \"<text x='\" & _PlotX & \"' y='\" & (_BaseY + 20) & \"' text-anchor='start' fill='\" & _TextSub & \"' font-size='10' font-family='Segoe UI'>\" & FORMAT(MINX(_Series2, [Sort]), \"MMM yy\") & \"</text>\" &",
