              "",
              "DAX Formula:",
              "",
              "",
              "VAR _Mom_diff =DIVIDE([Gross Margin %] - [Gross Margin % PY], [Gross Margin % PY])",
              "RETURN",
              "If(_Mom_diff> 0, Format(_Mom_diff, \"▲ 0.0%\") , Format(_Mom_diff, \"▼ 0.0%\")) & \" vs.PM\""
            ],
            "expression": [
              "",
              "",
              "VAR _Mom_diff =DIVIDE([Gross Margin %] - [Gross Margin % PY], [Gross Margin % PY])",
