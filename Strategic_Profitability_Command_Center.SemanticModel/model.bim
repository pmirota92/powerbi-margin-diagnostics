          {
            "name": "Price Impact",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Price Impact]",
              "",
              "DAX Formula:",
              "",
              "        VAR _AvgPriceLY = CALCULATE([Avg Unit Price], SAMEPERIODLASTYEAR('Date'[Date]))",
              "        RETURN SUMX('Fact_Sales', ([Avg Unit Price] - _AvgPriceLY) * 'Fact_Sales'[Quantity])"
            ],
            "expression": [
              "",
              "        VAR _AvgPriceLY = CALCULATE([Avg Unit Price], SAMEPERIODLASTYEAR('Date'[Date]))",
              "        RETURN SUMX('Fact_Sales', ([Avg Unit Price] - _AvgPriceLY) * 'Fact_Sales'[Quantity])"
