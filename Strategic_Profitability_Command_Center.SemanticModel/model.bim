          {
            "name": "Label Color GM % Diff",
            "description": [
              "Business Definition: [Please provide business logic for Label Color GM % Diff]",
              "",
              "DAX Formula:",
              "If(([Gross Margin %] - [Gross Margin % PY])>0,\"Green\", \"#F43F5E\")"
            ],
