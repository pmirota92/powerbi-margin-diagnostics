            "dataCategory": "ImageUrl",
            "description": [
              "Business Definition: [Please provide business logic for COGS SVG (Line Trend Gradient - AXES)]",
              "",
              "DAX Formula:",
              "",
              "VAR _CardTitle = \"COGS\"",
              "VAR _MeasureValue = [Total COGS]",
              "VAR _TargetValue  = 200000000",
              "VAR _MeasureFormat = \"$#,#\"",
              "VAR _TrendMeasure = [Total COGS]",
              "",
              "-- Motyw",
              "VAR _IsDarkMode = FALSE()",
              "VAR _CornerRadius = 33",
              "VAR _Bg1 = IF(_IsDarkMode, \"#2B2B2B\", \"#FFFFFF\")",
              "VAR _Bg2 = IF(_IsDarkMode, \"#111111\", \"#F5F5F5\")",
              "VAR _Border = IF(_IsDarkMode, \"#444444\", \"#DDDDDD\")",
              "VAR _TextMain = IF(_IsDarkMode, \"#FFFFFF\", \"#111111\")",
              "VAR _TextSub  = IF(_IsDarkMode, \"#B0B0B0\", \"#666666\")",
              "VAR _LineC1 = \"#FFB3B3\" -- Jasny czerwony (początek gradientu)",
              "VAR _LineC2 = \"#F43F5E\" -- Ciemny czerwony (linia i kropka)",
              "",
              "-- Layout (Większe marginesy, żeby nic nie uciekało)",
              "VAR _W = 382",
              "VAR _H = 282",
              "VAR _ChartX = 20",
              "VAR _ChartY = 145",
              "VAR _ChartW = 300",
              "VAR _ChartH = 110",
              "",
              "-- Marginesy wewnątrz wykresu",
              "VAR _PadL = 45   -- Miejsce na etykiety Y (np. 1.8M)",
              "VAR _PadR = 15",
              "VAR _PadT = 15",
              "VAR _PadB = 30   -- Miejsce na etykiety X (daty)",
              "",
              "VAR _PlotX = _ChartX + _PadL",
              "VAR _PlotY = _ChartY + _PadT",
              "VAR _PlotW = _ChartW - _PadL - _PadR",
              "VAR _PlotH = _ChartH - _PadT - _PadB",
              "VAR _BaseY = _PlotY + _PlotH",
              "",
              "-- Target i Wariancja",
              "-- VAR _Var = _TargetValue - _MeasureValue",
              "-- VAR _VarLabel = IF(_Var > 0, \"To Go: \", \"Exceeded: \")",
              "-- VAR _VarValue = FORMAT(ABS(_Var), _MeasureFormat)",
              "",
              "/* =========",
              "   Obliczanie MAX COGS i daty",
              "   ========= */",
              "-- 1. Znajdujemy najwyższy dzienny wynik w wybranym okresie",
              "VAR _MaxDailyRevenue = MAXX(VALUES('Date'[Date]), [Total COGS])",
              "",
              "-- 2. Szukamy konkretnej daty, w której wystąpił ten maksymalny wynik",
              "-- (Używamy MIN, aby w razie remisu - dwóch dni z tym samym wynikiem - wziąć pierwszą datę)",
              "VAR _MaxDate = ",
              "    CALCULATE(",
              "        MIN('Date'[Date]), ",
              "        FILTER(",
              "            VALUES('Date'[Date]), ",
              "            [Total Cogs] = _MaxDailyRevenue",
              "        )",
              "    )",
              "",
              "-- 3. Formatujemy wartości do wyświetlenia jako tekst",
              "VAR _FormattedMaxRev = FORMAT(_MaxDailyRevenue, \"$#,0\") -- Dodaj np. \"K\" lub \"M\" jeśli chcesz skrócić",
              "VAR _FormattedDate = FORMAT(_MaxDate, \"dd MMM yyyy\") -- Da wynik np. \"15 Jun 2023\"",
              "",
              "-- 4. Sklejamy gotową linijkę tekstu",
              "VAR _Var = \"MAX: \" & _FormattedMaxRev & \" | \" & _FormattedDate",
              "",
              "-- =========================",
              "-- Obliczanie Trendu (Miesięcznie)",
              "-- =========================",
              "VAR _LastDate = MAX('Date'[Date])",
              "-- Pobieramy listę ostatnich 12 miesięcy",
              "VAR _Months = ",
              "    CALCULATETABLE(",
              "        SUMMARIZE('Date', 'Date'[Date], \"Sort\", MIN('Date'[Date])),",
              "        DATESINPERIOD('Date'[Date], _LastDate, -12, MONTH)",
              "    )",
              "",
              "-- Obliczamy wartość miary dla każdego miesiąca",
              "VAR _Series0 = ",
              "    ADDCOLUMNS(",
              "        _Months,",
              "        \"@Val\", [Total COGS]",
              "    )",
              "",
              "VAR _SeriesNonBlank = FILTER(_Series0, NOT ISBLANK([@Val]))",
              "VAR _N = COUNTROWS(_SeriesNonBlank)",
              "",
              "-- Skalowanie Osi Y (Start od 0)",
              "VAR _ActualMaxV = MAXX(_SeriesNonBlank, [@Val])",
              "VAR _MaxV = IF(_ActualMaxV = 0, 1, _ActualMaxV * 1.2) -- 20% zapasu u góry",
              "VAR _MinV = 0",
              "VAR _Range = _MaxV - _MinV",
              "",
              "VAR _Series1 = ",
              "    ADDCOLUMNS(",
              "        _SeriesNonBlank,",
              "        \"__i\", RANKX(_SeriesNonBlank, [Sort],, ASC, DENSE)",
              "    )",
              "",
              "VAR _Series2 = ",
              "    ADDCOLUMNS(",
              "        _Series1,",
              "        \"__x\", _PlotX + DIVIDE(([__i] - 1) * _PlotW, MAX(_N - 1, 1)),",
              "        \"__y\", _BaseY - DIVIDE([@Val] * _PlotH, _Range)",
              "    )",
              "",
              "-- Ścieżki SVG",
              "VAR _PathLine = ",
              "    IF(_N >= 2, \"M \" & CONCATENATEX(_Series2, FORMAT([__x], \"0.0\") & \" \" & FORMAT([__y], \"0.0\"), \" L \", [Sort], ASC))",
              "",
              "VAR _PathArea = ",
              "    IF(",
              "        _N >= 2,",
              "        \"M \" & FORMAT(MINX(_Series2, [__x]), \"0.0\") & \" \" & FORMAT(_BaseY, \"0.0\") & ",
              "        \" L \" & CONCATENATEX(_Series2, FORMAT([__x], \"0.0\") & \" \" & FORMAT([__y], \"0.0\"), \" L \", [Sort], ASC) & ",
              "        \" L \" & FORMAT(MAXX(_Series2, [__x]), \"0.0\") & \" \" & FORMAT(_BaseY, \"0.0\") & \" Z\"",
              "    )",
              "",
              "-- Ostatni punkt",
              "VAR _LastXPt = MAXX(FILTER(_Series2, [__i] = _N), [__x])",
              "VAR _LastYPt = MAXX(FILTER(_Series2, [__i] = _N), [__y])",
              "",
              "-- =========================",
              "-- Osie i Etykiety",
              "-- =========================",
              "VAR _GridC = IF(_IsDarkMode, \"#3A3A3A\", \"#EEEEEE\")",
              "",
              "-- Etykiety Y: 0, 50%, 100%",
              "VAR _YSVG = ",
              "    CONCATENATEX(",
              "        GENERATESERIES(0, 2, 1),",
              "        VAR _val = [Value] * 0.5 * _MaxV",
              "        VAR _yPos = _BaseY - ([Value] * 0.5 * _PlotH)",
              "        VAR _label = IF(_val >= 1000000, FORMAT(_val/1000000, \"#.0\") & \"M\", IF(_val >= 1000, FORMAT(_val/1000, \"#\") & \"k\", FORMAT(_val, \"0\")))",
              "        RETURN",
              "        \"<line x1='\" & _PlotX & \"' y1='\" & _yPos & \"' x2='\" & (_PlotX + _PlotW) & \"' y2='\" & _yPos & \"' stroke='\" & _GridC & \"' stroke-width='1'/>\" &",
              "        \"<text x='\" & (_PlotX - 8) & \"' y='\" & (_yPos + 4) & \"' text-anchor='end' fill='\" & _TextSub & \"' font-size='10' font-family='Segoe UI'>\" & _label & \"</text>\"",
              "    )",
              "",
              "-- Etykiety X: Pierwszy i Ostatni miesiąc",
              "VAR _XTicks = ",
              "    \"<text x='\" & _PlotX & \"' y='\" & (_BaseY + 20) & \"' text-anchor='start' fill='\" & _TextSub & \"' font-size='10' font-family='Segoe UI'>\" & FORMAT(MINX(_Series2, [Sort]), \"MMM yy\") & \"</text>\" &",
              "    \"<text x='\" & (_PlotX + _PlotW) & \"' y='\" & (_BaseY + 20) & \"' text-anchor='end' fill='\" & _TextSub & \"' font-size='10' font-family='Segoe UI'>\" & FORMAT(MAXX(_Series2, [Sort]), \"MMM yy\") & \"</text>\"",
              "",
              "-- =========================",
              "-- Render",
              "-- =========================",
              "VAR _SVGraw = ",
              "\"<svg xmlns='http://www.w3.org/2000/svg' width='\" & _W & \"' height='\" & _H & \"' viewBox='0 0 \" & _W & \" \" & _H & \"'>\" &",
              "\"<defs>\" &",
              "\"  <linearGradient id='bgGrad' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='\" & _Bg1 & \"'/><stop offset='100%' stop-color='\" & _Bg2 & \"'/></linearGradient>\" &",
              "\"  <linearGradient id='areaGrad' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' stop-color='\" & _LineC2 & \"' stop-opacity='0.2'/><stop offset='100%' stop-color='\" & _LineC2 & \"' stop-opacity='0'/></linearGradient>\" &",
              "\"</defs>\" &",
              "\"<rect x='2' y='2' width='\" & (_W-4) & \"' height='\" & (_H-4) & \"' rx='\" & _CornerRadius & \"' fill='url(#bgGrad)' stroke='\" & _Border & \"' stroke-width='1'/>\" &",
              "\"<text x='22' y='40' fill='\" & _TextSub & \"' font-size='14' font-family='Segoe UI'>COGS</text>\" &",
              "\"<text x='22' y='90' fill='\" & _TextMain & \"' font-size='40' font-weight='700' font-family='Segoe UI'>\" & FORMAT(_MeasureValue, _MeasureFormat) & \"</text>\" &",
              "\"<text x='22' y='125' fill='\" & _TextSub & \"' font-size='13' font-family='Segoe UI'>\" & ",
              "    _Var & \"  <tspan fill='\" & _LineC2 & \"' font-weight='bold'>\"  & \"</tspan></text>\" &",
              "IF(",
              "    _N >= 2,",
              "    _YSVG & _XTicks & ",
              "    \"<path d='\" & _PathArea & \"' fill='url(#areaGrad)' />\" & ",
              "    \"<path d='\" & _PathLine & \"' fill='none' stroke='\" & _LineC2 & \"' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' />\" &",
              "    \"<circle cx='\" & FORMAT(_LastXPt,\"0.0\") & \"' cy='\" & FORMAT(_LastYPt,\"0.0\") & \"' r='5' fill='\" & _LineC2 & \"' stroke='white' stroke-width='2'/>\",",
              "    \"<text x='\" & (_PlotX) & \"' y='\" & (_PlotY + 30) & \"' fill='\" & _TextSub & \"'>Brak danych trendu</text>\"",
              ") &",
              "\"</svg>\"",
              "",
              "RETURN",
              "\"data:image/svg+xml;utf8,\" & _SVGraw"
            ],
            "expression": [
