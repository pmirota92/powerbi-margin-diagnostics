    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "functions": [
      {
        "name": "EdwardCharles.CardChip",
        "expression": [
          "(",
          "\tcolorScheme : SCALAR STRING VAL,\t// Chip Color Scheme",
          "\ticonType : SCALAR STRING VAL, \t\t// Better, Worse, or \"\"",
          "\tvalueText : SCALAR STRING VAL,      // Non-bold Value",
          "\tlabelText : SCALAR STRING VAL,\t\t// Bold Label",
          "\tcenterAdjust : SCALAR Int64 VAL,\t// Adds or Subtracts Length to the End of the Chip",
          "\tminValueLength : SCALAR Int64 VAL,  // Minimum Value Length",
          "\tminLabelLength : SCALAR Int64 VAL  \t// Minimum Label Length",
          ")",
          "=>",
          "\tVAR bgColor =",
          "\t\tSWITCH(",
          "\t\t\tcolorScheme,",
          "\t\t\t\"spring\", \"#ECFDF5\",",
          "\t\t\t\"sunset\", \"#FFF7ED\",",
          "\t\t\t\"ocean\",  \"#E0F2FE\",",
          "\t\t\t\"forest\", \"#D1FAE5\",",
          "\t\t\t\"rose\",   \"#FEF2F2\",",
          "\t\t\t\"lavender\", \"#F3E8FF\",",
          "\t\t\t\"gold\",   \"#FFFBEB\",",
          "\t\t\t\"peach\",  \"#FFF1E6\",",
          "\t\t\t\"ice\",    \"#EFF6FF\",",
          "\t\t\t\"citrus\", \"#FEF9C3\",",
          "\t\t\t\"#F9FAFB\"  -- default",
          "\t\t)",
          "",
          "\tVAR borderColor =",
          "\t\tSWITCH(",
          "\t\t\tcolorScheme,",
          "\t\t\t\"spring\", \"#A7F3D0\",",
          "\t\t\t\"sunset\", \"#FDBA74\",",
          "\t\t\t\"ocean\",  \"#7DD3FC\",",
          "\t\t\t\"forest\", \"#4ADE80\",",
          "\t\t\t\"rose\",   \"#FECACA\",",
          "\t\t\t\"lavender\", \"#C084FC\",",
          "\t\t\t\"gold\",   \"#FBBF24\",",
          "\t\t\t\"peach\",  \"#FDBA91\",",
          "\t\t\t\"ice\",    \"#60A5FA\",",
          "\t\t\t\"citrus\", \"#FACC15\",",
          "\t\t\t\"#E5E7EB\"",
          "\t\t)",
          "",
          "\tVAR textColor =",
          "\t\tSWITCH(",
          "\t\t\tcolorScheme,",
          "\t\t\t\"spring\", \"#047857\",",
          "\t\t\t\"sunset\", \"#C2410C\",",
          "\t\t\t\"ocean\",  \"#0369A1\",",
          "\t\t\t\"forest\", \"#065F46\",",
          "\t\t\t\"rose\",   \"#B91C1C\",",
          "\t\t\t\"lavender\", \"#7E22CE\",",
          "\t\t\t\"gold\",   \"#B45309\",",
          "\t\t\t\"peach\",  \"#9A3412\",",
          "\t\t\t\"ice\",    \"#1E40AF\",",
          "\t\t\t\"citrus\", \"#A16207\",",
          "\t\t\t\"#374151\"",
          "\t\t)",
          "",
          "\tVAR iconColor =",
          "\t\tSWITCH(",
          "\t\t\tcolorScheme,",
          "\t\t\t\"spring\", \"#059669\",",
          "\t\t\t\"sunset\", \"#EA580C\",",
          "\t\t\t\"ocean\",  \"#0284C7\",",
          "\t\t\t\"forest\", \"#10B981\",",
          "\t\t\t\"rose\",   \"#DC2626\",",
          "\t\t\t\"lavender\", \"#9333EA\",",
          "\t\t\t\"gold\",   \"#D97706\",",
          "\t\t\t\"peach\",  \"#C2410C\",",
          "\t\t\t\"ice\",    \"#2563EB\",",
          "\t\t\t\"citrus\", \"#CA8A04\",",
          "\t\t\t\"#6B7280\"",
          "\t\t)",
          "",
          "\tVAR iconPath =",
          "\t\tSWITCH (",
          "\t\t\ticonType,",
          "\t\t\t\"better\",",
          "\t\t\t\t\"M21.75 6L15 12.75l-4.5 -4.5L2.25 16.5M21.75 6h-4.5m4.5 0v4.5\",",
          "\t\t\t\"worse\",",
          "\t\t\t\t\"M21.75 18L15 11.25l-4.5 4.5L2.25 7.5M21.75 18h-4.5m4.5 0v-4.5\",\"\"",
          "\t\t\t//\"M5.25 12h13.5\"",
          "\t\t)",
          "",
          "\tVAR paddingX = 12",
          "\tVAR iconSize = if(iconType = \"\", 0, 16)",
          "\tVAR gap = if(iconType = \"\", 0, 8)",
          "\tVAR valueLength = if(LEN ( valueText ) > minValueLength, LEN ( valueText ),minValueLength)",
          "\tVAR labelLength = if(LEN ( labelText ) > minLabelLength, LEN ( labelText ),minLabelLength)",
          "",
          "\tVAR svgHeight = 28",
          "\tVAR centerY = svgHeight / 2",
          "",
          "\tVAR valueX = paddingX + iconSize + gap",
          "\tVAR labelX = valueX + valueLength * 7 + 8",
          "",
          "\tVAR svgWidth = labelX +  labelLength  * 7 + paddingX + centerAdjust",
          "",
          "\tVAR icon = \"<svg x='\" & paddingX & \"' y='\" & ( centerY - iconSize / 2 ) & \"' \" &",
          "\t\t\"width='\" & iconSize & \"' height='\" & iconSize & \"' viewBox='0 0 24 24' \" &",
          "\t\t\"fill='none' stroke='\" & iconColor & \"' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>\" &",
          "\t\t\"<path d='\" & iconPath & \"' />\" &",
          "\t\t\"</svg>\"",
          "",
          "\tVAR valueText = \"<text x='\" & valueX & \"' y='\" & centerY & \"' font-size='12' font-weight='600' \" &",
          "\t\t\"dominant-baseline='middle' text-anchor='start' \" &",
          "\t\t\"font-family='Segoe UI, SF Pro Text, -apple-system, Roboto, Helvetica Neue, sans-serif' fill='\" & textColor & \"'>\" &",
          "\t\tvalueText &",
          "\t\t\"</text>\"",
          "",
          "\tVAR labelText =\"<text x='\" & labelX & \"' y='\" & centerY & \"' font-size='12' font-weight='400' opacity='0.75' \" &",
          "\t\t\"dominant-baseline='middle' text-anchor='start' \" &",
          "\t\t\"font-family='Segoe UI, SF Pro Text, -apple-system, Roboto, Helvetica Neue, sans-serif' fill='\" & textColor & \"'>\" &",
          "\t\tlabelText &",
          "\t\t\"</text>\"",
          "\tRETURN",
          "\t\"data:image/svg+xml;utf8,\" &",
          "\t\"<svg xmlns='http://www.w3.org/2000/svg' width='\" & svgWidth & \"' height='\" & svgHeight & \"'>\" &",
          "\t\t\"<rect x='0.5' y='0.5' rx='8' ry='8' width='\" & svgWidth - 1 & \"' height='\" & svgHeight - 1 & \"' \" &",
          "\t\t\t\"fill='\" & bgColor & \"' stroke='\" & borderColor & \"'/>\" &",
          "\t\t\ticon &",
          "\t\t\tvalueText &",
          "\t\t\tlabelText &",
          "\t\"</svg>\""
        ],
        "lineageTag": "c3b4d2cc-2c9c-4b01-8916-67bec9b72bd6"
      }
