          {
            "name": "Excessive Discount Impact",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "description": [
              "Business Definition: [Please provide business logic for Excessive Discount Impact]",
              "",
              "DAX Formula:",
              "",
              "        SUMX(",
              "            'Fact_Sales',",
              "            VAR _DiscPct = DIVIDE('Fact_Sales'[Discount_Amount], 'Fact_Sales'[Revenue] + 'Fact_Sales'[Discount_Amount])",
              "            RETURN IF(_DiscPct > 0.15, 'Fact_Sales'[Discount_Amount], 0)",
              "        )"
            ],
            "expression": [
              "",
              "        SUMX(",
              "            'Fact_Sales',",
              "            VAR _DiscPct = DIVIDE('Fact_Sales'[Discount_Amount], 'Fact_Sales'[Revenue] + 'Fact_Sales'[Discount_Amount])",
              "            RETURN IF(_DiscPct > 0.15, 'Fact_Sales'[Discount_Amount], 0)",
              "        )"
            ],
            "formatString": "#,0",
            "lineageTag": "2a01677a-86c0-4024-a361-9051738248a2"
          },
          {
            "name": "Upsell Opportunity Potential",
