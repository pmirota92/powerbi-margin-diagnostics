              "    \"<circle cx='\" & FORMAT(_LastXPt,\"0.0\") & \"' cy='\" & FORMAT(_LastYPt,\"0.0\") & \"' r='5' fill='\" & _LineC2 & \"' stroke='white' stroke-width='2'/>\",",
